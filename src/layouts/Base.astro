---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { checkDescription } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  nav?: 'practice' | 'cities' | 'method' | 'guides' | 'home';
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Absolute path to this page's share card, 1200x630. See the og:image block below. */
  image?: string;
  /** What the share card shows, for the platforms and readers that surface it. */
  imageAlt?: string;
}
const { title, description, nav = 'home', schema, noindex: pageNoindex = false,
        image, imageAlt } = Astro.props;
// Build-time switch (Cloudflare → Settings → Build → Variables): LFL_NOINDEX=true keeps the whole site out of search engines until launch.
const noindex = pageNoindex || import.meta.env.LFL_NOINDEX === 'true';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Every page passes through here, so this is the one place the description-length rule can be
// enforced without each page remembering it.
checkDescription(description, Astro.url.pathname);
const siteName = 'Law Firm Listings';
// The brand suffix is worth about twenty characters, and a search result shows about sixty.
// On a firm whose own name runs to ten surnames it was pushing the city and the practice past
// the cut, so the page appeared in results as a name and an ellipsis. Above the threshold the
// page's own title is the whole title: a reader who has got that far knows whose site it is.
const fullTitle = title.includes(siteName) || title.length > 52 ? title : `${title} | ${siteName}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    {/* Google Search Console ownership. It belongs in the head: Google reads this tag from the
        head of the page it is verifying and ignores it anywhere else. On every page rather than
        just the home page, because verification survives whichever URL is submitted, and because
        a tag that lives in the layout cannot be lost the next time a page is rewritten.

        Not a secret. A verification token proves control of the site to whoever already has the
        Search Console property; it grants nothing on its own and is meant to be served publicly
        in the HTML. */}
    <meta name="google-site-verification" content="sR3JxIaW5fDkrIudyfYNCTgsj2f60U_N-U9T_hFlNT4" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {/* The share card. A page's cover is drawn inline as vector art, which is right on the page
        and useless to Facebook, LinkedIn, Slack and X: none of them renders an SVG og:image, and
        a link posted without one is a grey box. So each guide ships a committed raster of its own
        cover at the size every platform expects, with alt text, and a page that has none simply
        omits the tag rather than pointing at something that does not exist. */}
    {image && (
      <>
        <meta property="og:image" content={new URL(image, Astro.site).href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL(image, Astro.site).href} />
        {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- iOS ignores an SVG icon, and a home-screen shortcut without this one shows a
         screenshot of the page. Both are the same gradient, written by scripts/prepare_brand.py. -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Urbanist:wght@300;400;500;600;700&display=swap" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <Header nav={nav} />
    <main><slot /></main>
    <Footer />
  </body>
</html>
