---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { publishedGuides } from '../data/guides';

// The hero preview and the "certified this month" grid both render real firms.
// They used to be hand-written mock-ups naming firms that do not exist.
const published = await getCollection('firms', f =>
  f.data.status !== 'sample' && f.data.status !== 'not_eligible');

const certified = published
  .filter(f => f.data.status === 'certified' && f.data.score)
  .sort((a, b) => (b.data.score!.total) - (a.data.score!.total));

// The guides section was hand-written: it advertised a ranking that is still gated, invented
// a firm count and a read time, and two of its three cards linked to "#". It now reads the
// manifest, so publishing a guide puts it on the home page and nothing here can describe an
// article that does not exist.
const homeGuides = publishedGuides(published).slice(0, 3);

const lead = certified[0] ?? published[0] ?? null;
const leadPrimary = lead?.data.practices.find(pr => pr.primary) ?? lead?.data.practices[0];
const leadHq = lead?.data.offices.find(o => o.is_hq) ?? lead?.data.offices[0];
const leadGoogle = lead?.data.reviews.google;
const leadSelfReported = leadGoogle ? /as reported by the firm/i.test(leadGoogle.source) : false;
// Only results backed by a docket or document count; nothing else may imply an outcome.
const leadVerifiedResults = lead ? lead.data.results.filter(r => r.verified).length : 0;

const cityCounts = [...new Set(published.map(f => f.data.market.city_slug))].map(slug => {
  const inCity = published.filter(f => f.data.market.city_slug === slug);
  return { label: `${inCity[0].data.market.city}, ${inCity[0].data.market.state}`, count: inCity.length };
}).sort((a, b) => b.count - a.count);

const practiceCount = new Set(published.flatMap(f => f.data.practices.map(pr => pr.slug))).size;

// The situations grid is navigation copy — people know what happened to them, not which kind of
// lawyer they need — so the eight entries stay. Their firm counts were invented, and the seven
// practice areas we have not started have no page to link to. Each tile now shows a count only
// when there are firms behind it, and links only where a page exists.
const PAGES = new Set(['personal-injury']);
const SITUATIONS = [
  { slug: 'personal-injury', icon: 'car', name: 'Personal Injury', title: 'I was hurt in an accident', desc: 'Car, truck, work or construction injuries, slip & fall, medical mistakes' },
  { slug: 'family-law', icon: 'heart', name: 'Family Law', title: "I'm getting divorced or need custody help", desc: 'Divorce, child custody and support, prenups, domestic violence orders' },
  { slug: 'criminal-defense', icon: 'gavel', name: 'Criminal Defense', title: "I've been arrested or charged", desc: 'DUI, drug and assault charges, white-collar and federal investigations' },
  { slug: 'immigration', icon: 'globe', name: 'Immigration', title: 'I need a visa, green card or citizenship', desc: 'Family and work visas, asylum, naturalization, removal defense' },
  { slug: 'employment', icon: 'users', name: 'Employment', title: 'I was fired, harassed or underpaid', desc: 'Wrongful termination, discrimination, unpaid wages, severance review' },
  { slug: 'estate-planning', icon: 'pen', name: 'Estate Planning', title: "I want to protect my family's future", desc: 'Wills, trusts, probate, powers of attorney, elder care planning' },
  { slug: 'business-law', icon: 'briefcase', name: 'Business Law', title: "I'm starting or running a business", desc: 'Formation, contracts, partnerships, disputes, mergers' },
  { slug: 'real-estate', icon: 'home', name: 'Real Estate', title: "I'm buying, selling or renting property", desc: 'Closings, landlord–tenant disputes, evictions, zoning, title issues' },
].map(s => ({
  ...s,
  count: published.filter(f => f.data.practices.some(pr => pr.slug === s.slug)).length,
  href: PAGES.has(s.slug) ? `/practice-areas/${s.slug}/` : null,
}));

// The hero used to state "4,800+ certified firms" and "12,400+ verified client reviews". Both
// were invented. These are the real aggregates, summed across published firms.
const digits = (s: string) => Number(String(s).replace(/[^\d]/g, '') || 0);
const freeConsultShare = published.length
  ? Math.round((100 * published.filter(f => f.data.free_consultation).length) / published.length)
  : null;

const withReviews = published.filter(f => f.data.reviews.google);
const reviewTotal = withReviews.reduce((n, f) => n + digits(f.data.reviews.google!.count_label), 0);
const ratingAvg = reviewTotal
  ? Math.round((withReviews.reduce((s, f) =>
      s + f.data.reviews.google!.rating * digits(f.data.reviews.google!.count_label), 0) / reviewTotal) * 100) / 100
  : null;

const computedDates = published.map(f => f.data.score?.computed_at).filter(Boolean) as string[];
const lastUpdated = computedDates.length
  ? new Date(computedDates.sort().at(-1)!).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
  : null;
const logoVariants = ['', 'l2', 'l3'];
// The hero search routes in the browser against the pages that exist. Built from the
// collection, so a new city or practice area is searchable as soon as it has a page.
const PRACTICE_PAGES = new Set(['personal-injury']);
const searchIndex = {
  practices: [...new Map(published.flatMap(f => f.data.practices)
    .filter(pr => PRACTICE_PAGES.has(pr.slug))
    .map(pr => [pr.slug, pr.name])).entries()]
    .map(([slug, name]) => ({ slug, name, href: `/practice-areas/${slug}/` })),
  cities: [...new Map(published.map(f =>
    [f.data.market.city_slug, { city: f.data.market.city, state: f.data.market.state }])).entries()]
    .map(([slug, m]) => ({ slug, name: `${m.city}, ${m.state}`, city: m.city, state: m.state,
                           href: `/cities/${slug}/` })),
};

---
{/* The description is the snippet Google shows, so it says what the directory holds today.
    It read "top-rated law firms in 100 U.S. cities and every practice area" — one city, one
    practice area. */}
<Base title="Law Firm Listings — Law Firms Verified, Not Advertised" description="Find and compare US law firms on verified evidence: licensure, disciplinary history, client reviews, case results and fee terms. No firm can pay to rank." nav="home">
<!-- HERO -->
<section class="hero">
  <div class="aurora" aria-hidden="true"><i class="b1"></i><i class="b2"></i><i class="b3"></i><span class="glow"></span><span class="noise"></span></div>
  <div class="container">
    {ratingAvg && <div class="trust-pill"><span class="avs"><i></i><i></i><i></i><i></i></span><span class="stars">{'★'.repeat(Math.round(ratingAvg))}</span><span><b>{ratingAvg.toFixed(2)}</b> · {reviewTotal.toLocaleString()} client reviews from Google Business Profiles</span></div>}
    <h1>The law firm directory built on <span class="grad-text">verification</span>, not advertising.</h1>
    <p class="lede">Every firm here is checked for active licensure, clean disciplinary records and verified client outcomes — and no firm can pay to rank. {published.length} {published.length === 1 ? 'firm' : 'firms'} published so far, starting with personal injury in New York.</p>
    <form class="search-panel" id="firm-search" action="/practice-areas/personal-injury/" method="get">
      <div class="search-field">
        <Icon name="search" />
        <div style="flex:1"><label for="q">Legal matter</label><input id="q" type="text" placeholder="Car accident, divorce, DUI…"></div>
      </div>
      <div class="search-field">
        <Icon name="pin" />
        <div style="flex:1"><label for="loc">City or state</label><input id="loc" type="text" placeholder="New York, NY"></div>
      </div>
      <button class="btn btn--primary" type="submit">Search firms</button>
      <p class="search-note" hidden id="search-note"></p>
    </form>
    <script is:inline define:vars={{ searchIndex }}>
  // Client-side only: no request leaves the browser until the visitor is sent to a page that
  // already exists. A matter or city we do not cover yet says so instead of pretending.
  (function () {
    var form = document.getElementById('firm-search');
    if (!form) return;
    var note = document.getElementById('search-note');
    var norm = function (s) { return (s || '').toLowerCase().replace(/[^a-z\s]/g, ' ').trim(); };

    // Everyday words for a matter, mapped to the practice slug they belong to. Only slugs that
    // have a page are in searchIndex, so an unmatched term is genuinely uncovered.
    var MATTER_HINTS = {
      'personal-injury': ['injury', 'injured', 'hurt', 'accident', 'crash', 'car', 'truck',
        'motorcycle', 'pedestrian', 'slip', 'fall', 'construction', 'malpractice', 'negligence',
        'wrongful death', 'work', 'workers', 'compensation', 'premises', 'dog bite']
    };

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var matter = norm(document.getElementById('q').value);
      var where = norm(document.getElementById('loc').value);

      var city = searchIndex.cities.find(function (c) {
        var n = norm(c.name), just = norm(c.city);
        return where && (n.indexOf(where) > -1 || where.indexOf(just) > -1 ||
                         just.indexOf(where) > -1 || norm(c.state) === where);
      });

      var practice = searchIndex.practices.find(function (p) {
        if (matter && norm(p.name).indexOf(matter) > -1) return true;
        var hints = MATTER_HINTS[p.slug] || [];
        return matter && hints.some(function (h) { return matter.indexOf(h) > -1; });
      });

      if (practice) { window.location.href = practice.href; return; }
      // A matter was typed and matched nothing: say so rather than routing to the city anyway.
      // Sending someone looking for a divorce lawyer to a personal-injury page, silently, is
      // the kind of helpfulness that misleads.
      if (city && !matter) { window.location.href = city.href; return; }

      if (note) {
        var have = searchIndex.practices.map(function (p) { return p.name; }).join(', ');
        var places = searchIndex.cities.map(function (c) { return c.name; }).join(', ');
        note.textContent = (matter || where)
          ? 'We do not cover that yet. So far the directory holds ' + have + ' in ' + places + '.'
          : 'Tell us what happened, or pick one of the popular searches below.';
        note.hidden = false;
      }
    });
  })();
</script>
    <div class="hero-popular"><span>Popular:</span><a href="/practice-areas/personal-injury/">Personal injury</a><a href="#">Divorce</a><a href="#">Criminal defense</a><a href="#">Immigration</a><a href="#">Estate planning</a></div>

    <div class="hero-preview" aria-hidden="true">
      {lead && (
        <div class="glass">
          <div class="firm"><div class="avatar">{lead.data.initials}</div><div><b>{lead.data.name}</b><span>{leadPrimary?.name} · {leadHq?.label.split('—')[0].trim()}, {lead.data.market.state}</span></div></div>
          {leadGoogle && (
            <div class="stars">{'★'.repeat(Math.round(leadGoogle.rating))} <small>{leadGoogle.rating.toFixed(1)} · {leadGoogle.count_label} reviews{leadSelfReported ? ', as reported by the firm' : ''}</small></div>
          )}
          {lead.data.status === 'certified' && (
            <span class="badge badge--certified"><Icon name="shield" /> LFL Certified 2026</span>
          )}
          <div class="img"><Icon name="skyline" /><span class="hv-placeholder">Custom image slot</span></div>
          <div class="row"><span>Offices <b>{lead.data.offices.length}</b></span><span>Free consult <b>{lead.data.free_consultation ? 'Yes' : 'No'}</b></span><span>Fee <b>{lead.data.fee_model}</b></span></div>
        </div>
      )}
      {lead?.data.score && (
        <div class="glass">
          <div class="k">Certification score</div><div class="v num">{lead.data.score.total}<span style="font-size:1rem;color:var(--on-night-soft)">/100</span></div>
          <div class="sub">Licensure · Discipline · Results · Reviews</div>
          <div class="bar"><i style={`width:${lead.data.score.total}%`}></i></div>
          <div class="row"><span>Bar status <b>{lead.data.gates.G1?.pass ? 'Active' : 'Pending'}</b></span><span>Discipline <b>{lead.data.gates.G2?.pass ? 'None' : 'Pending'}</b></span></div>
          <div class="row" style="border:0;padding:0;margin-top:8px"><span>Verified results <b>{leadVerifiedResults > 0 ? leadVerifiedResults : 'Pending'}</b></span><span>A+B+C <b>{lead.data.score.floor_abc}/65</b></span></div>
        </div>
      )}
      <div class="glass">
        <div class="k">Certified firms</div><div class="v num">{certified.length}</div>
        <div class="sub">across {cityCounts.length} {cityCounts.length === 1 ? 'city' : 'U.S. cities'} · {practiceCount} practice areas</div>
        {cityCounts.slice(0, 2).map(c => (
          <div class="row"><span>{c.label} <b class="num">{c.count}</b></span></div>
        ))}
        <div class="row" style="border:0;padding:0;margin-top:8px"><span>Updated <b>{lastUpdated ?? '—'}</b></span><span class="badge badge--live">● Live</span></div>
      </div>
    </div>
  </div>
</section>

<!-- SITUATIONS -->
<section class="section" style="border-top:0;padding-top:72px">
  <div class="container">
    <div class="section-head">
      <div><span class="eyebrow">Start with your situation</span><h2 style="margin-top:12px">Tell us what happened. We'll show you who's certified to handle it.</h2><p>Most people don't know which kind of lawyer they need — they know what's going on in their life. Start there.</p></div>
      
    </div>
    <div class="sit-grid">
      {SITUATIONS.map(s => {
        const inner = (
          <>
            <span class="ico"><Icon name={s.icon} /></span>
            <div><b>{s.title}</b><span>{s.desc}</span></div>
            <em>{s.name}{s.count > 0 ? <> · <span class="num">{s.count}</span> {s.count === 1 ? 'firm' : 'firms'}</> : ''}</em>
          </>
        );
        return s.href
          ? <a class="sit" href={s.href}>{inner}</a>
          : <div class="sit is-soon">{inner}</div>;
      })}
    </div>
  </div>
</section>

<!-- CITIES & STATES -->
<section class="section section--paper">
  <div class="container">
    <div class="section-head">
      <div><span class="eyebrow">Certified firms near you</span><h2 style="margin-top:12px">Ranked city by city, not nationally.</h2><p>Licensure is checked against each state's bar, and rankings are built city by city — a top firm in Houston is ranked against Houston, not Boston.</p></div>
      
    </div>
    <div class="city-grid">
      {cityCounts.map((c, i) => (
        <a class={`city c${(i % 8) + 1}`} href={`/cities/${published.find(f => `${f.data.market.city}, ${f.data.market.state}` === c.label)!.data.market.city_slug}/`}>
          <Icon name="sky_sm" /><div class="t"><b>{c.label}</b><span class="num">{c.count} {c.count === 1 ? 'firm' : 'firms'}</span></div>
        </a>
      ))}
    </div>
    <div class="states">
      <span class="lbl">Browse by state</span>
      <div class="chips">
        <a class="chip" href="#">California</a><a class="chip" href="#">Texas</a><a class="chip" href="#">Florida</a><a class="chip" href="#">New York</a><a class="chip" href="#">Illinois</a><a class="chip" href="#">Pennsylvania</a><a class="chip" href="#">Georgia</a><a class="chip" href="#">Arizona</a><a class="chip" href="#">New Jersey</a><a class="chip" href="#">Washington</a><a class="chip" href="#">Massachusetts</a><a class="chip" href="#">Colorado</a><a class="chip" href="#">All 50 states →</a>
      </div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee" aria-hidden="true">
  <div class="track">
    <span>Licensure verified</span><span>No pay-to-rank</span><span>Verified client outcomes</span><span>100 U.S. cities</span><span>Free consultations</span><span>Updated monthly</span><span>Independent editorial methodology</span>
    <span>Licensure verified</span><span>No pay-to-rank</span><span>Verified client outcomes</span><span>100 U.S. cities</span><span>Free consultations</span><span>Updated monthly</span><span>Independent editorial methodology</span>
  </div>
</div>

<!-- WHAT CERTIFIED MEANS -->
<section class="section section--night cert-section">
  <div class="aurora" aria-hidden="true"><i class="b1"></i><i class="b2"></i></div>
  <div class="container" style="position:relative">
    <div class="cert-grid">
      <div>
        <span class="eyebrow">What "certified" means</span>
        <h2 style="margin-top:14px">Most directories sell placement. We verify firms — and publish exactly how.</h2>
        <p class="lede" style="color:var(--on-night-soft);margin-top:18px">A firm earns the <b style="color:#fff">LFL Certified</b> badge only after four checks pass. It can't be bought, it's re-checked every month, and it's revoked the moment a public disciplinary action appears.</p>
        <div class="criteria" style="margin-top:28px">
          <div class="criterion"><Icon name="shield" /><div><b>1 · Licensure &amp; discipline</b><span>Every named attorney active with the state bar and free of public discipline for 10 years.</span></div></div>
          <div class="criterion"><Icon name="scale" /><div><b>2 · Verified outcomes</b><span>At least three case results confirmed against court records or documentation.</span></div></div>
          <div class="criterion"><Icon name="star" /><div><b>3 · Client experience</b><span>25+ verified client reviews with a 4.5 average, weighted for recency and detail.</span></div></div>
          <div class="criterion"><Icon name="users" /><div><b>4 · Peer recognition</b><span>Confidential evaluations from attorneys in the same market and practice area.</span></div></div>
        </div>
        <a class="btn btn--white" href="#" style="margin-top:28px">Read the full methodology</a>
      </div>
      <div class="compare-wrap">
        <table class="compare">
          <thead><tr><th>What you get</th><th class="us">Law Firm Listings</th><th>Paid directories</th><th>Search &amp; reviews</th></tr></thead>
          <tbody>
            <tr><td>Bar licensure checked for every attorney</td><td class="us"><Icon name="check" /></td><td>—</td><td>—</td></tr>
            <tr><td>Disciplinary history screened</td><td class="us"><Icon name="check" /></td><td>—</td><td>—</td></tr>
            <tr><td>Case results verified against records</td><td class="us"><Icon name="check" /></td><td>Self-reported</td><td>—</td></tr>
            <tr><td>Firms can pay to rank higher</td><td class="us">Never</td><td>Yes</td><td>Ads</td></tr>
            <tr><td>Ranked against local competitors</td><td class="us"><Icon name="check" /></td><td>Partial</td><td>—</td></tr>
            <tr><td>Fee model &amp; free-consult shown up front</td><td class="us"><Icon name="check" /></td><td>Sometimes</td><td>—</td></tr>
            <tr><td>Re-verified</td><td class="us">Monthly</td><td>Annually</td><td>—</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- FEATURED FIRMS -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <div><span class="eyebrow">Certified this month</span><h2 style="margin-top:12px">Firms that just earned the 2026 certification</h2><p>New certifications are published on the first business day of each month, after licensure, discipline and results checks are complete.</p></div>
      <a class="link" href="/practice-areas/personal-injury/">View all rankings</a>
    </div>
    <div class="feat-grid">
      {certified.map((f, i) => {
        const pr = f.data.practices.find(x => x.primary) ?? f.data.practices[0];
        const g = f.data.reviews.google;
        const self = g ? /as reported by the firm/i.test(g.source) : false;
        return (
          <article class="feat">
            <div class="top"><div class={logoVariants[i % logoVariants.length] ? `firm-logo ${logoVariants[i % logoVariants.length]}` : 'firm-logo'}>{f.data.initials}</div><span class="badge badge--certified"><Icon name="shield" /> Certified 2026</span></div>
            <div><h3><a href={`/firms/${f.data.slug}/`}>{f.data.name}</a></h3><span class="where">{pr?.name} · {f.data.market.city}, {f.data.market.state}</span></div>
            <p>{f.data.about[0] ?? f.data.tagline}</p>
            <div class="foot">
              {g
                ? <><span class="stars">{'★'.repeat(Math.round(g.rating))} <b>{g.rating.toFixed(1)}</b></span><span class="muted num">{g.count_label} reviews{self ? ', as reported by the firm' : ''}</span></>
                : <span class="muted num">Reviews pending verification</span>}
            </div>
          </article>
        );
      })}
    </div>
    {certified.length === 0 && (
      <div class="callout"><b>No certifications published yet.</b> The first cohort is in verification; certified firms appear here on the first business day of the month.</div>
    )}
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="section section--paper">
  <div class="container">
    <div class="section-head">
      <div><span class="eyebrow">How it works</span><h2 style="margin-top:12px">From "what do I do now?" to a booked consultation</h2><p>No account, no forms sold to lead brokers. You choose who to contact, and the firm hears from you directly.</p></div>
    </div>
    <div class="steps">
      <div class="step"><h3>Describe your situation</h3><p>Pick what's happening and your city. Or just search — "rear-ended on the BQE" works as well as "car accident lawyer".</p></div>
      <div class="step"><h3>Compare certified firms</h3><p>Ratings, fee model, verified results, languages and consultation availability, side by side and in plain English.</p></div>
      <div class="step"><h3>Talk to the firm — free</h3><p>Request a consultation directly.{freeConsultShare !== null && <> {freeConsultShare}% of the firms published here offer the first call free.</>} None of them pays us a referral fee.</p></div>
    </div>
  </div>
</section>

<!-- GUIDES -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <div><span class="eyebrow">What we measured</span><h2 style="margin-top:12px">The analysis behind the score, published</h2><p>Every figure in these pieces is computed from the same data the profiles use, so a correction reaches the article and the ranking at once. No paywall and no sponsorship.</p></div>
      <a class="link" href="/guides/">All guides</a>
    </div>
    {homeGuides.length > 0 ? (
      <div class="guide-grid">
        {homeGuides.map((g, i) => (
          <a class={i === 0 ? 'guide guide--lead' : 'guide'} href={`/guides/${g.slug}/`}>
            <div class={g.thumb ? `thumb ${g.thumb}` : 'thumb'}><Icon name={g.icon ?? 'skyline'} /></div>
            <div class="body">
              <span class="kicker">{g.kicker}</span>
              <h3>{g.title}</h3>
              {i === 0 && <p>{g.summary}</p>}
              {g.meta && <span class="meta">{g.meta}</span>}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="callout"><b>Nothing published yet.</b> Guides appear here as they are written.</div>
    )}
  </div>
</section>

<!-- FAQ -->
<section class="section section--paper">
  <div class="container faq-split">
    <div><span class="eyebrow">Questions people ask first</span><h2 style="margin-top:14px">Before you hire anyone</h2><p style="margin-top:14px;max-width:38ch">Short answers to the questions we hear most. Every guide is reviewed by a licensed attorney in the relevant state.</p><a class="link" href="/guides/" style="margin-top:20px">Browse all guides</a></div>
    <div class="faq">
      <details open><summary>How much does a lawyer cost?</summary><div>It depends on the matter. Personal injury firms almost always work on contingency (typically 33⅓%, nothing up front). Divorce, criminal defense and business work are usually hourly ($250–$1,200) or flat-fee. Every profile shows the fee model before you call.</div></details>
      <details><summary>Is a "certified" firm better than a highly rated one?</summary><div>Ratings tell you how clients felt. Certification tells you the attorneys are licensed, undisciplined and have results we could verify. The best firms have both — and our rankings weight them together.</div></details>
      <details><summary>Do law firms pay to be listed here?</summary><div>No. Being listed is free, and so is claiming your profile to keep its information current. The Certification Score, the eligibility gates and the tier cannot be bought or edited by anyone, including a firm that manages its own profile. Firms may buy optional tools and clearly labeled sponsored placements; neither appears inside a ranked list.</div></details>
      <details><summary>What happens when I request a consultation?</summary><div>Your message goes straight to the firm — we don't sell it to other lawyers and we take no referral fee.{freeConsultShare !== null && <> {freeConsultShare}% of the firms published here offer the first consultation free.</>} How quickly a firm replies is up to the firm; we do not measure it yet, so we do not promise it.</div></details>
      <details><summary>What if a firm loses its certification?</summary><div>If a public disciplinary action appears or verified reviews fall below our threshold, the badge is removed within 30 days and the firm drops out of ranked lists until it re-qualifies.</div></details>
    </div>
  </div>
