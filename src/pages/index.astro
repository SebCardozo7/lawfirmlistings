---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CoverArt from '../components/CoverArt.astro';
import { PRACTICE_SLUGS, hasPractice } from '../data/practices';
import { publishedGuides } from '../data/guides';
import { BADGE_YEAR } from '../lib/badge';

/**
 * The home page, rebuilt 2026-11-11.
 *
 * What it was: a hero claiming we check "verified client outcomes", a grid of situations, a
 * list of cities, nine certified firms, three guides and a For-firms box that never named the
 * product. Sixty-one internal links out of 1,635 published URLs, which made the page that
 * receives every external link the worst connected one on the site. Search Console says the
 * city-by-practice lists carry thousands of impressions at position 57 to 79 and no clicks,
 * and the only clicks the site has ever had are brand queries landing on firm profiles. The
 * thing that moves page six to page one is authority, and the cheapest authority we own is the
 * link equity this page was sitting on.
 *
 * Every number below is counted from the collection at build time. That is deliberate and it
 * is the whole point: the old page stated figures a person had typed, and two of them were
 * invented. A number that is computed cannot go stale and cannot be wrong in one place and
 * right in another.
 *
 * The claim that is gone. "Verified client outcomes" was true of none of the 1,388 published
 * firms: the `results` array is empty on every one of them. What we actually measure is what a
 * firm publishes about its own results, which is `results_published`, and 782 of 1,388 publish
 * nothing readable at all. On a site whose entire argument is that it only publishes what it
 * can check, that sentence was the most expensive one we had.
 */
const published = await getCollection('firms', f =>
  f.data.status !== 'sample' && f.data.status !== 'not_eligible');

const scored = published.filter(f => f.data.score);
const certified = published
  .filter(f => f.data.status === 'certified' && f.data.score)
  .sort((a, b) => b.data.score!.total - a.data.score!.total);

/** The highest-scoring firm in the directory, which carries the hero and the worked example. */
const top = [...scored].sort((a, b) => b.data.score!.total - a.data.score!.total)[0] ?? null;
const topPractice = top?.data.practices.find(p => p.primary) ?? top?.data.practices[0];
const topOffice = top?.data.offices.find(o => o.is_hq) ?? top?.data.offices[0];
const topGoogle = top?.data.reviews.google;
/** The town, not the street: "New Hyde Park" rather than "2001 Marcus Ave W295". */
const townOf = (address?: string) => {
  const parts = String(address ?? '').split(',').map(s => s.trim());
  return parts.length >= 3 ? parts[parts.length - 3] : '';
};

const digits = (s: string) => Number(String(s).replace(/[^\d]/g, '') || 0);

// The record, counted rather than asserted.
const attorneyCount = published.reduce((n, f) => n + f.data.attorneys.length, 0);
const faqCount = published.reduce((n, f) => n + f.data.faq.length, 0);
const withReviews = published.filter(f => f.data.reviews.google);
const reviewTotal = withReviews.reduce((n, f) => n + digits(f.data.reviews.google!.count_label), 0);
const ratingAvg = reviewTotal
  ? Math.round((withReviews.reduce((s, f) =>
      s + f.data.reviews.google!.rating * digits(f.data.reviews.google!.count_label), 0)
      / reviewTotal) * 100) / 100
  : null;

// Every city × practice combination that has a page, which is the unit this site ranks in.
const combos = new Map<string, { city: string; practice: string; label: string; n: number }>();
for (const f of published) {
  for (const pr of f.data.practices) {
    if (!hasPractice(pr.slug)) continue;
    const key = `${f.data.market.city_slug}/${pr.slug}`;
    const row = combos.get(key);
    if (row) row.n += 1;
    else combos.set(key, {
      city: f.data.market.city_slug, practice: pr.slug,
      label: `${pr.name} · ${f.data.market.city}, ${f.data.market.state}`, n: 1,
    });
  }
}
const listCount = combos.size;
const topLists = [...combos.values()].sort((a, b) => b.n - a.n).slice(0, 10);

/** The ranked list shown open: the one with the most firms behind it. */
const lead = topLists[0];
const leadFirms = lead
  ? published
      .filter(f => f.data.market.city_slug === lead.city
        && f.data.practices.some(pr => pr.slug === lead.practice))
      .sort((a, b) => (b.data.score?.total ?? -1) - (a.data.score?.total ?? -1))
  : [];
const leadName = lead ? published.find(f => f.data.market.city_slug === lead.city)!.data.market : null;
const leadPracticeName = lead
  ? published.find(f => f.data.practices.some(p => p.slug === lead.practice))!
      .data.practices.find(p => p.slug === lead.practice)!.name
  : '';

const cityRows = [...new Map(published.map(f => [f.data.market.city_slug, f.data.market])).values()]
  .map(m => ({ ...m, n: published.filter(f => f.data.market.city_slug === m.city_slug).length }))
  .sort((a, b) => b.n - a.n);

/**
 * States, each pointing at its own largest city.
 *
 * Every state chip used to carry href="/cities/", so thirteen links on the most linked page of
 * the site went to one destination and told a crawler nothing about any state. There is no
 * /states/ route yet, so the chip goes to the biggest city we publish in that state, which is
 * at least a page about somewhere in it.
 */
const stateRows = [...new Map(published.map(f => [f.data.market.state, f.data.market])).values()]
  .map(m => {
    const inState = cityRows.filter(c => c.state === m.state);
    return {
      name: m.state_name, abbr: m.state, href: `/cities/${inState[0].city_slug}/`,
      n: inState.reduce((s, c) => s + c.n, 0),
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name));

/**
 * Where each city sits on the map, as x,y in the 760×420 viewBox.
 *
 * Hand-placed from latitude and longitude on an equirectangular projection of the lower 48,
 * because adding two fields to every market record to draw one picture is a worse trade than a
 * lookup table that lives beside the picture. A city with no entry simply gets no dot, which is
 * why the legend counts the dots rather than the cities.
 */
const CITY_XY: Record<string, [number, number]> = {
  'new-york-ny': [668, 139], 'miami-fl': [587, 391], 'los-angeles-ca': [88, 251],
  'san-diego-ca': [103, 273], 'chicago-il': [490, 120], 'phoenix-az': [169, 261],
  'las-vegas-nv': [129, 215], 'atlanta-ga': [532, 256], 'houston-tx': [388, 323],
  'philadelphia-pa': [653, 152], 'san-antonio-tx': [347, 329], 'buffalo-ny': [604, 102],
  'baltimore-md': [634, 163], 'boston-ma': [707, 112], 'naples-fl': [566, 384],
  'portland-or': [30, 58], 'dallas-tx': [369, 273], 'lakeland-fl': [564, 352],
  'northwest-indiana': [493, 131],
};
const mapped = cityRows.filter(c => CITY_XY[c.city_slug])
  .map(c => ({ ...c, xy: CITY_XY[c.city_slug], r: 4 + Math.sqrt(c.n) / 2.2 }));

/**
 * Markets measured and not yet published. They are on the map because they are true: the
 * cohorts are written and the practice pass is done. They come off it the day they open.
 */
const OPENING: { label: string; xy: [number, number]; n: number }[] = [
  { label: 'Orlando', xy: [572, 344], n: 95 },
  { label: 'New Orleans', xy: [458, 320], n: 94 },
  { label: 'Detroit', xy: [549, 112], n: 115 },
];
const openingTotal = OPENING.reduce((s, m) => s + m.n, 0);

// The three findings. Counted here so the article and the home page cannot disagree.
const withInsurance = published.filter(f => f.data.accountability?.malpractice_insurance).length;
const noResults = published.filter(f => !(f.data.results_published?.count ?? 0)).length;
const noAttorneys = published.filter(f => f.data.attorneys.length === 0).length;
const noAttorneyPct = Math.round((1000 * noAttorneys) / published.length) / 10;

// Firms that have earned a tier they can show on their own site.
const EARNED = new Set(['Verified', 'Certified', 'Distinguished', 'Elite']);
const earned = scored.filter(f => EARNED.has(f.data.score!.tier));
const eliteCount = scored.filter(f => f.data.score!.tier === 'Elite').length;

/** The logo wall: real marks, highest scoring first, at most three to a city. */
const logoSeen = new Map<string, number>();
const logoFirms: typeof published = [];
for (const f of [...scored].sort((a, b) => b.data.score!.total - a.data.score!.total)) {
  if (!f.data.logo) continue;
  const city = f.data.market.city_slug;
  if ((logoSeen.get(city) ?? 0) >= 3) continue;
  logoSeen.set(city, (logoSeen.get(city) ?? 0) + 1);
  logoFirms.push(f);
  if (logoFirms.length >= 24) break;
}
const withLogo = published.filter(f => f.data.logo).length;
const logoRowA = logoFirms.slice(0, 12);
const logoRowB = logoFirms.slice(12, 24);

const homeGuides = publishedGuides(published).slice(0, 3);
const guideCount = publishedGuides(published).length;

const lastUpdated = (() => {
  const dates = published.map(f => f.data.score?.computed_at).filter(Boolean) as string[];
  return dates.length
    ? new Date(dates.sort().at(-1)!).toLocaleDateString('en-US',
        { month: 'long', year: 'numeric', timeZone: 'UTC' })
    : null;
})();

const freeConsultShare = published.length
  ? Math.round((100 * published.filter(f => f.data.free_consultation).length) / published.length)
  : null;

// The situations grid. Each tile counts real firms and links only where a page exists.
const PAGES = new Set(PRACTICE_SLUGS);
const SITUATIONS = [
  { slug: 'personal-injury', icon: 'car', title: 'I was hurt in an accident', desc: 'Car and truck crashes, slip and fall, medical mistakes, wrongful death' },
  { slug: 'workers-compensation', icon: 'briefcase', title: 'I was hurt at work', desc: 'Workplace and construction injuries, benefits denied or stopped' },
  { slug: 'medical-malpractice', icon: 'heart', title: 'A doctor or hospital got it wrong', desc: 'Misdiagnosis, surgical error, birth injury, nursing home neglect' },
  { slug: 'criminal-defense', icon: 'gavel', title: 'I have been arrested or charged', desc: 'DUI, drug and assault charges, white collar and federal investigations' },
  { slug: 'family-law', icon: 'users', title: 'I am getting divorced or need custody help', desc: 'Divorce, child custody and support, prenups, protection orders' },
  { slug: 'immigration', icon: 'globe', title: 'I need a visa, green card or citizenship', desc: 'Family and work visas, asylum, naturalization, removal defense' },
].map(s => {
  const n = published.filter(f => f.data.practices.some(pr => pr.slug === s.slug)).length;
  const cities = new Set(published.filter(f => f.data.practices.some(pr => pr.slug === s.slug))
    .map(f => f.data.market.city_slug)).size;
  return { ...s, n, cities, href: PAGES.has(s.slug) ? `/practice-areas/${s.slug}/` : null };
});

const popular = SITUATIONS.filter(s => s.href).slice(0, 4);

const searchIndex = {
  practices: [...new Map(published.flatMap(f => f.data.practices)
    .filter(pr => PAGES.has(pr.slug))
    .map(pr => [pr.slug, pr.name])).entries()]
    .map(([slug, name]) => ({ slug, name, href: `/practice-areas/${slug}/` })),
  cities: cityRows.map(m => ({ slug: m.city_slug, name: `${m.city}, ${m.state}`,
                               city: m.city, state: m.state, href: `/cities/${m.city_slug}/` })),
};

const pillars: { key: string; name: string; max: number; blurb: string }[] = [
  { key: 'A', name: 'Professional Standing', max: 25, blurb: "Licensure, discipline, years in practice, and whether the firm's roster can be verified against the bar." },
  { key: 'B', name: 'Published Outcomes', max: 15, blurb: 'What the firm publishes about its results, how specific it is, and whether the disclaimer sits beside it.' },
  { key: 'C', name: 'Client Experience', max: 20, blurb: 'Review volume, rating quality, how recent the reviews are, and the share of them that are complaints.' },
  { key: 'D', name: 'Digital Presence', max: 25, blurb: "Core Web Vitals, search authority as a percentile of the firm's own city, local presence, structured data." },
  { key: 'E', name: 'Access', max: 15, blurb: 'Free consultation and fee transparency, languages, accessibility, and when a human can be reached.' },
];
const topPillars = top ? pillars.map(p => ({
  ...p, got: top.data.score!.pillars?.[p.key]?.score ?? 0,
})) : [];
const weakest = [...topPillars].sort((a, b) => (a.got / a.max) - (b.got / b.max))[0];
const firstSub = top?.data.score?.pillars?.A?.subs?.[0];

// No figure in here. check_meta refuses one, and it is right to: a count baked into the snippet
// Google caches is a number that goes wrong somewhere we cannot see it.
const desc = 'Compare US law firms on public records: licensure, discipline, client reviews and '
  + 'what each firm publishes about its fees. No firm can pay to rank.';
---
<Base title="Law Firm Listings: Law Firms Verified, Not Advertised" description={desc} nav="home">

<!-- HERO -->
<section class="hm-hero">
  <div class="hm-aurora" aria-hidden="true"><i class="b1"></i><i class="b2"></i><i class="b3"></i></div>
  <div class="hm-grid-lines" aria-hidden="true"></div>
  <div class="container hm-hero-grid">
    <div>
      {ratingAvg && (
        <div class="hm-pill">
          <span class="hm-stars" aria-hidden="true">
            <Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" />
          </span>
          <span><b>{reviewTotal.toLocaleString('en-US')}</b> client reviews read &middot; <b>{ratingAvg.toFixed(2)}</b> average</span>
        </div>
      )}

      <h1>The law firm directory built on <span class="grad-text">verification</span>, not advertising.</h1>

      <p class="hm-lede"><b>No firm can buy a place here.</b> Not the top spot, not a point, not a
        badge. All <b>{published.length.toLocaleString('en-US')}</b> of them are read from their
        own public record, scored out of 100 in the open, and measured again every month.</p>

      <form class="hm-search" id="firm-search" action="/practice-areas/personal-injury/" method="get">
        <div class="hm-field">
          <label for="q">Legal matter</label>
          <input id="q" type="text" placeholder="Car accident, divorce…" autocomplete="off">
        </div>
        <div class="hm-field hm-field--split">
          <label for="loc">City or state</label>
          <input id="loc" type="text" placeholder="New York, NY" autocomplete="off">
        </div>
        <button class="btn btn--primary" type="submit"><Icon name="search" /> Search</button>
        <p class="hm-note" hidden id="search-note"></p>
      </form>

      <div class="hm-popular">
        <span>Popular:</span>
        {popular.map(s => <a class="chip" href={s.href!}>{s.slug.replace(/-/g, ' ').replace(/^\w/, c => c.toUpperCase())}</a>)}
        <a class="chip chip--more" href="/practice-areas/">All {searchIndex.practices.length} practice areas</a>
      </div>
    </div>

    {top && (
      <div class="hm-art">
        <div class="hm-orbit" aria-hidden="true"></div>
        <div class="hm-orbit hm-orbit--in" aria-hidden="true"></div>

        <div class="hm-chip hm-chip--l"><span class="hm-tick"><Icon name="check" /></span>Licence active</div>
        <div class="hm-chip hm-chip--r"><span class="hm-live" aria-hidden="true"></span>Re-measured monthly</div>

        <article class="hm-card hm-float">
          <header>
            {top.data.logo
              ? <img class="hm-fav" src={top.data.logo.file} alt="" width="40" height="40" loading="lazy" />
              : <span class="hm-fav hm-fav--txt">{top.data.initials}</span>}
            <div>
              <b>{top.data.name}</b>
              <span>{topPractice?.name} &middot; {top.data.market.city}, {top.data.market.state}</span>
            </div>
            <span class="hm-badge"><Icon name="shield" /> {top.data.score!.tier}</span>
          </header>

          <div class="hm-gauge">
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <circle cx="60" cy="60" r="50" fill="none" stroke="var(--tint)" stroke-width="10" />
              <circle class="v" cx="60" cy="60" r="50" fill="none" stroke="#6D5BF0" stroke-width="10"
                      stroke-linecap="round" stroke-dasharray="314"
                      style={`stroke-dashoffset:${314 - (314 * top.data.score!.total) / 100}`} />
            </svg>
            <div><strong>{top.data.score!.total}</strong><span>of 100</span></div>
          </div>

          <ul class="hm-pillars">
            {topPillars.map((p, i) => (
              <li>
                <span><b>{p.key} &middot; {p.name.split(' ')[0]}</b><em>{p.got}/{p.max}</em></span>
                <span class="hm-bar"><i style={`width:${(100 * p.got) / p.max}%;animation-delay:${i * 0.1}s`}></i></span>
              </li>
            ))}
          </ul>
        </article>
        <p class="hm-caption">Every sub-score links the evidence it came from.</p>
      </div>
    )}
  </div>

  <!-- THE WALL OF MARKS -->
  <div class="hm-wall">
    <div class="container hm-wall-head">
      <p><b>{withLogo.toLocaleString('en-US')}</b> of the {published.length.toLocaleString('en-US')} published firms carry their own mark here. Not one of them paid to be on this page.</p>
    </div>
    <div class="hm-fade" aria-hidden="true"></div>
    <div class="hm-track">
      {[...logoRowA, ...logoRowA].map(f => (
        <span class="hm-logo"><img src={f.data.logo!.file} alt="" loading="lazy" /></span>
      ))}
    </div>
    <div class="hm-track hm-track--rev">
      {[...logoRowB, ...logoRowB].map(f => (
        <span class="hm-logo"><img src={f.data.logo!.file} alt="" loading="lazy" /></span>
      ))}
    </div>
  </div>
</section>

<!-- THE RECORD -->
<section class="hm-record">
  <div class="hm-aurora hm-aurora--low" aria-hidden="true"><i class="b1"></i><i class="b2"></i></div>
  <div class="container">
    <h2>The record behind the rankings</h2>
    <div class="hm-stats">
      <div><strong>{published.length.toLocaleString('en-US')}</strong><span class="hm-bar"><i style="width:100%;background:#8B5CF6"></i></span><span>firms measured in full, not sampled</span></div>
      <div><strong>{attorneyCount.toLocaleString('en-US')}</strong><span class="hm-bar"><i style="width:86%;background:#7C7BF0;animation-delay:.1s"></i></span><span>attorneys named one by one</span></div>
      <div><strong>{reviewTotal.toLocaleString('en-US')}</strong><span class="hm-bar"><i style="width:94%;background:#5B9BF8;animation-delay:.2s"></i></span><span>client reviews read</span></div>
      <div><strong>{listCount}</strong><span class="hm-bar"><i style="width:62%;background:#3FBFD4;animation-delay:.3s"></i></span><span>ranked lists, city by practice</span></div>
      <div><strong>{faqCount.toLocaleString('en-US')}</strong><span class="hm-bar"><i style="width:74%;background:#35C8B0;animation-delay:.4s"></i></span><span>questions answered on profiles</span></div>
      <div><strong>{certified.length}</strong><span class="hm-bar"><i style="width:46%;background:#5EEAD4;animation-delay:.5s"></i></span><span>firms certified for {new Date().getUTCFullYear()}</span></div>
    </div>
    <p class="hm-record-foot">Every number on this row is counted from the published profiles, and
      every one of them is a link away from being checked. <a href="/methodology/">See how a firm is scored</a>.</p>
  </div>
</section>

<!-- SITUATIONS -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">Start with your situation</span>
        <h2>Tell us what happened. We will show you who is measured to handle it.</h2>
        <p>Most people do not know which kind of lawyer they need. They know what is going on in their life. Start there.</p>
      </div>
    </div>
    <div class="hm-sits">
      {SITUATIONS.map(s => {
        const Tag = s.href ? 'a' : 'div';
        return (
          <Tag class="hm-sit" href={s.href ?? undefined}>
            <span class="hm-ico"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            {s.n > 0 && <span class="hm-count"><b>{s.n.toLocaleString('en-US')}</b> firms &middot; {s.cities} {s.cities === 1 ? 'city' : 'cities'}</span>}
          </Tag>
        );
      })}
    </div>
  </div>
</section>

<!-- RANKED LISTS -->
{lead && (
<section class="section section--paper" id="lists">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">Ranked lists</span>
        <h2>{listCount} ranked lists, one per city and practice</h2>
        <p>A firm is ranked against the firms a client would actually choose between. Houston against Houston, never against Boston.</p>
      </div>
      <a class="link" href="/cities/">Browse every city</a>
    </div>

    <div class="hm-lists">
      <div class="hm-list-card">
        <div class="hm-list-head">
          <div>
            <span class="eyebrow">Ranked by the Certification Score</span>
            <h3>{leadPracticeName} lawyers in {leadName!.city}</h3>
          </div>
          {lastUpdated && <span class="chip"><span class="hm-live" aria-hidden="true"></span>Updated {lastUpdated}</span>}
        </div>
        <ol class="hm-rank">
          {leadFirms.slice(0, 3).map((f, i) => (
            <li class={i === 0 ? 'is-first' : undefined}>
              <span class="hm-pos">{String(i + 1).padStart(2, '0')}</span>
              {f.data.logo
                ? <img class="hm-fav" src={f.data.logo.file} alt="" width="40" height="40" loading="lazy" />
                : <span class="hm-fav hm-fav--txt">{f.data.initials}</span>}
              <span class="hm-who">
                <a href={`/firms/${f.data.slug}/`}>{f.data.name}</a>
                {f.data.status === 'certified' && <span class="hm-badge"><Icon name="shield" /> Certified</span>}
                <em>{townOf(f.data.offices[0]?.address)}{f.data.reviews.google
                  ? ` · ${f.data.reviews.google.count_label} reviews · ${f.data.reviews.google.rating.toFixed(1)}`
                  : ''}</em>
              </span>
              <span class="hm-sc">
                <strong>{f.data.score?.total ?? '—'}</strong><span>/100</span>
                <span class="hm-bar"><i style={`width:${f.data.score?.total ?? 0}%;animation-delay:${i * 0.1}s`}></i></span>
              </span>
            </li>
          ))}
          <li class="is-rest">
            <span class="hm-pos">04</span>
            <span class="hm-fav hm-fav--txt">+{leadFirms.length - 3}</span>
            <span class="hm-who"><b>And {leadFirms.length - 3} more firms in this list</b>
              <em>Every one with its score, its sub-scores and the evidence behind them</em></span>
            <a class="link" href={`/cities/${lead.city}/${lead.practice}/`}>Open list</a>
          </li>
        </ol>
      </div>

      <div>
        <span class="eyebrow">Deepest lists in the directory</span>
        <ul class="hm-list-links">
          {topLists.map(l => (
            <li><a href={`/cities/${l.city}/${l.practice}/`}>
              <span>{l.label}</span><em>{l.n}</em>
            </a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
)}

<!-- CITIES, WITH THE MAP -->
<section class="section" id="cities">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">Certified firms near you</span>
        <h2>Ranked city by city, not nationally.</h2>
        <p>Licensure is checked against each state's bar, and rankings are built city by city, so a top firm in Houston is ranked against Houston.</p>
      </div>
      <a class="link" href="/cities/">All {cityRows.length} cities</a>
    </div>

    <div class="hm-map">
