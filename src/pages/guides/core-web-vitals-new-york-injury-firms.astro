---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuideCover from '../../components/GuideCover.astro';
import BarChart from '../../components/BarChart.astro';
import ColumnChart from '../../components/ColumnChart.astro';
import Takeaways from '../../components/Takeaways.astro';

// A short technical piece, written so the article template is in production and so pillar D has
// something public explaining it. Every figure below is computed from the firms collection at
// build time rather than typed in, so the article cannot drift away from the data it describes.
// New York only, which the title has always said and the filter did not. The directory opened in
// Baltimore and Lakeland after this piece was written, and without the state test the page began
// counting Maryland and Florida firms while calling every one of them a New York firm.
const firms = await getCollection('firms', f =>
  f.data.status !== 'sample' && f.data.status !== 'not_eligible' && f.data.market.state === 'NY');

const withPsi = firms.filter(f => f.data.digital.psi);
const passing = withPsi.filter(f => f.data.digital.psi!.value.cwv_pass);
const worst = [...withPsi].sort((a, b) =>
  a.data.digital.psi!.value.performance - b.data.digital.psi!.value.performance);
const best = [...worst].reverse();
const median = (xs: number[]) => {
  const s = [...xs].sort((a, b) => a - b);
  const m = Math.floor(s.length / 2);
  return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
};
const medianPerf = withPsi.length ? median(withPsi.map(f => f.data.digital.psi!.value.performance)) : null;

const noSchema = firms.filter(f => f.data.digital.schema_detected === false);
const attorneyTotal = firms.reduce((n, f) => n + f.data.attorneys.length, 0);
// Two different things, and conflating them put a false sentence on a live page. `barNumbersOnBios`
// is what a firm publishes about its own attorneys, read from its bio pages by the crawler.
// `registryMatched` is how many of those attorneys WE tied to the state register, which is our
// work and not the firm's. The sentence below used to say "not one publishes a bar registration
// number" and read the second number, which was 0 until scripts/check_ny_registry.py started
// writing bar_number onto every attorney it matched. The prose then claimed 419 firms publish
// something none of them publishes, and nothing failed, because both numbers are real.
const barNumbersOnBios = firms.filter(
  f => f.data.digital.trust_pages?.bar_numbers_on_bios).length;
const registryMatched = firms.reduce(
  (n, f) => n + f.data.attorneys.filter(a => a.bar_number).length, 0);

// The distribution, because forty-odd bars is a list and not a chart. Bands are Google's own
// reporting bands for the performance score, so the shape is comparable to anything else that
// quotes them. The pass rate is a separate fact and the caption carries it.
const PERF_BANDS = [
  { label: '90 to 100', note: 'good', lo: 90 },
  { label: '50 to 89', note: 'needs work', lo: 50 },
  { label: 'Under 50', note: 'poor', lo: 0 },
];
const perfColumns = PERF_BANDS.map((b, i) => ({
  label: b.label,
  note: b.note,
  value: withPsi.filter(f => {
    const p = f.data.digital.psi!.value.performance;
    const hi = i === 0 ? Infinity : PERF_BANDS[i - 1].lo;
    return p >= b.lo && p < hi;
  }).length,
}));

// The named firms stay as the table had them: the three fastest and the three slowest, which is
// the spread the paragraph is about, with the pass mark carried by the highlight and the note.
const namedRows = [...best.slice(0, 3), ...worst.slice(0, 3).reverse()].map(f => ({
  label: f.data.name,
  href: `/firms/${f.data.slug}/`,
  value: f.data.digital.psi!.value.performance,
  note: f.data.digital.psi!.value.cwv_pass ? 'Passes Core Web Vitals' : 'Fails Core Web Vitals',
  emphasis: f.data.digital.psi!.value.cwv_pass,
}));

const measuredOn = withPsi[0]?.data.digital.psi!.measured_at ?? null;
const updated = measuredOn
  ? new Date(measuredOn).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : null;

// Says the finding, not the topic. No count in it: check_meta rejects a figure in a title, and a
// pass rate that moves every month should not be the thing Google has indexed.
const title = "New Study: Almost Every New York Injury Firm Fails Google's Speed Test";
const description = 'We ran PageSpeed Insights against every New York injury firm in this directory. Almost all fail Core Web Vitals. What it costs them, and what fixes it.';
---
<Base title={title} description={description} nav="guides" image="/og/speed.png" imageAlt="A speed gauge with its needle in the slowest zone, over a city skyline">
<article>
<header class="article-head">
  <div class="narrow">
    <ol class="crumbs"><li><a href="/">Home</a></li><li><a href="/practice-areas/personal-injury/">Personal Injury</a></li><li aria-current="page">Core Web Vitals</li></ol>
    <span class="eyebrow" style="margin-top:18px">Technical · Digital presence</span>
    <h1>{title}</h1>
    <p class="lede">We ran Google's PageSpeed Insights against every New York personal injury firm in the directory. Of the {withPsi.length} we could measure, <b>{passing.length}</b> passed Core Web Vitals. This is what we measured, why the score counts it, and why it is the cheapest thing on a firm's list to fix.</p>
    <div class="byline">
      <div class="who"><span class="av" aria-hidden="true"></span><div><b>By the Law Firm Listings Editorial Team</b>Measured data, no legal content</div></div>
      {updated && <><span class="sep" aria-hidden="true"></span><span>Measured {updated}</span></>}
      <span class="sep" aria-hidden="true"></span>
      <span>3 min read</span>
    </div>
  </div>
</header>

<GuideCover name="speed" />

<div class="container article-grid">
  <nav class="toc" aria-label="On this page">
    <h4>On this page</h4>
    <ol>
      <li><a href="#what" class="is-active">What we measured</a></li>
      <li><a href="#results">The results</a></li>
      <li><a href="#why" >Why the score counts it</a></li>
      <li><a href="#fix">What a firm can do</a></li>
    </ol>
  </nav>

  <div class="prose">
    <Takeaways
      scope={`Measured with PageSpeed Insights across ${withPsi.length} firms${updated ? `, ${updated}` : ''}.`}
      items={[
        `<b>${passing.length} of ${withPsi.length}</b> firms pass Core Web Vitals. The median performance score is <b>${medianPerf}</b> out of 100.`,
        `The gap between the fastest and the slowest firm here is <b>${(best[0]?.data.digital.psi?.value.performance ?? 0) - (worst[0]?.data.digital.psi?.value.performance ?? 0)} points</b>, which is the difference between a page that loads and one a reader abandons.`,
        `<b>${noSchema.length} firms</b> publish no structured data at all, so a search engine has to guess what their pages are about.`,
        `<b>${barNumbersOnBios === 0 ? 'Not one firm' : `Only ${barNumbersOnBios} of ${firms.length}`}</b> publishes a bar registration number on its attorney bios, which is the cheapest thing any of them could do to make a roster checkable.`,
      ]}
    />
    <div class="callout"><b>How to read this.</b> Every figure on this page is computed from our own measurements at build time, so it changes when the data does. Nothing here is legal information or advice.</div>

    <h2 id="what">What we measured</h2>
    <p>Core Web Vitals are Google's three field metrics for how a page actually behaves for a visitor: how long the largest piece of content takes to appear (LCP), how much the layout jumps while loading (CLS), and how long the page ignores input while it works (INP, approximated in lab data by total blocking time). Google's own thresholds are LCP at or under 2.5 seconds, CLS at or under 0.1, and blocking time at or under 200 milliseconds. A page passes only if all three clear.</p>
    <p>We measured each firm's home page through the PageSpeed Insights API on mobile. Where a site has enough real-user traffic the result includes field data; otherwise it is lab only, which is weaker evidence, and we record which one a measurement came from.</p>

    <h2 id="results">The results</h2>
    <p>{withPsi.length} of the {firms.length} firms in the directory could be measured. {passing.length === 1 ? 'One passed.' : `${passing.length} passed.`} The median performance score was {medianPerf}.</p>
    <ColumnChart
      heading={`Mobile performance score across the ${withPsi.length} firms we could measure`}
      columns={perfColumns}
      caption={`Google's own bands for the performance score, out of 100. Passing Core Web Vitals is a separate and stricter test: ${passing.length} of the ${withPsi.length} clear all three.`}
    />
    <BarChart
      heading="The three fastest and the three slowest"
      max={100}
      rows={namedRows}
      caption="Out of 100, measured on mobile. A highlighted bar is a firm that passes all three Core Web Vitals, which is not the same as scoring well: the note under each name says which it is."
    />
    <p>The spread is wide. {best[0] && <><a href={`/firms/${best[0].data.slug}/`}>{best[0].data.name}</a> scores {best[0].data.digital.psi!.value.performance}</>}{worst[0] && <>, while <a href={`/firms/${worst[0].data.slug}/`}>{worst[0].data.name}</a> scores {worst[0].data.digital.psi!.value.performance}</>}. These are firms competing for the same clients on the same search terms.</p>
    <p>Two other things turned up while we were looking.</p>
    {noSchema.length > 0 && (
      <p>{noSchema.length === 1 ? 'One firm publishes' : `${noSchema.length} firms publish`} no structured data at all, not a line of JSON-LD. That costs a point, and it makes the site harder for search engines and AI assistants to read.</p>
    )}
    <p>And of the {firms.length} firms whose attorney bios we have read, {barNumbersOnBios === 0 ? 'not one' : barNumbersOnBios} publishes a bar registration number on them. <b>That is the single easiest way for a firm to make its own attorney roster verifiable</b>, and it is the reason we have to match {attorneyTotal.toLocaleString('en-US')} names against the state register ourselves: {registryMatched} of them resolve to a registration, and the rest stay unverifiable by anybody.</p>

    <h2 id="why">Why the score counts it</h2>
    <p>Website performance sits in pillar D of the LFL Certification Score, worth 25 of 100, and Core Web Vitals is the first thing in it.</p>
    <p><b>The reasoning is not that a fast site makes a better lawyer.</b> It is that a firm which maintains its own site is a firm that is reachable, current and accountable. It is the same reason the pillar rewards published fee terms, attorney credentials and a working contact method.</p>
    <p>Pillar D is also deliberately capped. It can lift a firm's tier but it cannot create one: certification requires professional standing, verified outcomes and client experience to reach 40 of their combined 65.</p>
    <p>A firm with an excellent website and thin verified results plateaus, by design. <a href="/methodology/">The full methodology</a> sets out every sub-factor and the evidence behind it.</p>
    <p>One caveat applies to every figure above. A site we could not measure keeps its sub-factor pending rather than scoring zero, which takes those points out of the denominator, so a firm's total is a share of what we read rather than of a hundred. <a href="/guides/what-a-law-firm-score-cannot-compare/">We measured how far that moves a score</a>, and it moves it further than any state line does.</p>

    <h2 id="fix">What a firm can do</h2>
    <p><b>Of everything the score measures, this is the part a firm controls outright</b>, and it changes in weeks rather than years.</p>
    <p>Compressing hero images, deferring third-party scripts and serving fonts locally will move all three metrics. Chat widgets and tag managers are the usual culprits behind a long blocking time.</p>
    <p>Publishing bar admission numbers on attorney bios is a text change.</p>
    <p>Every firm can see its own sub-scores and the evidence behind each one on its profile. If a measurement looks wrong, the profile links to the source we used.</p>
    <p class="muted" style="font-size:.86rem">Measurements come from the Google PageSpeed Insights API. A site we cannot measure keeps that sub-factor pending rather than receiving an estimated score.</p>
  </div>

  <aside class="article-aside">
    <div class="panel panel--ink">
      <h4>See the directory</h4>
      <p>Every firm above has a profile showing its offices, fees, client reviews and measured digital presence.</p>
      <a class="btn btn--white" href="/practice-areas/personal-injury/">Personal injury firms</a>
    </div>
    <div class="panel">
      <h4>How scoring works</h4>
      <ul>
        <li><a href="/methodology/">LFL Certified Methodology</a></li>
        <li><a href="/guides/what-a-law-firm-score-cannot-compare/">What a score cannot compare</a></li>
      </ul>
    </div>
  </aside>
</div>
</article>
</Base>
