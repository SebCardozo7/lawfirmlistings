---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuideCover from '../../components/GuideCover.astro';
import BarChart from '../../components/BarChart.astro';
import ColumnChart from '../../components/ColumnChart.astro';
import StackBar from '../../components/StackBar.astro';

// A method piece about pillar B, and a count of what every firm in the directory publishes about
// its own outcomes. Every figure is computed from the firms collection at build time, so the
// article cannot drift away from the data. Nothing here prints a dollar amount: the amounts we
// hold are the firms' own figures, none of them is confirmed, and the profile templates already
// refuse to repeat them. This page keeps the same rule.
const firms = await getCollection('firms', f =>
  f.data.status !== 'sample' && f.data.status !== 'not_eligible');

type Firm = typeof firms[number];
const rp = (f: Firm) => f.data.results_published;

// Four populations, and the difference between them is the whole point of the piece: a page we
// could not read is not a firm that publishes nothing.
const checked = firms.filter(f => rp(f));
const unchecked = firms.filter(f => !rp(f));
const readable = checked.filter(f => rp(f)!.readable);
const unreadable = checked.filter(f => !rp(f)!.readable);
const publishers = readable.filter(f => (rp(f)!.count ?? 0) > 0);
const silent = readable.filter(f => !(rp(f)!.count ?? 0));

const totalResults = publishers.reduce((n, f) => n + (rp(f)!.count ?? 0), 0);
const counts = publishers.map(f => rp(f)!.count!).sort((a, b) => a - b);
const medianCount = counts.length
  ? (counts.length % 2 ? counts[(counts.length - 1) / 2]
    : (counts[counts.length / 2 - 1] + counts[counts.length / 2]) / 2)
  : 0;
const most = [...publishers].sort((a, b) => rp(b)!.count! - rp(a)!.count!)[0];

const withAmounts = publishers.filter(f => rp(f)!.amounts.length);
const amountsCount = publishers.reduce((n, f) => n + rp(f)!.amounts.length, 0);
const billionScale = publishers
  .flatMap(f => rp(f)!.amounts).filter(a => a >= 1_000_000_000).length;
const withAggregate = publishers.filter(f => rp(f)!.aggregate_claims.length);
const withVenue = publishers.filter(f => rp(f)!.venues.length);
const withCaseTypes = publishers.filter(f => rp(f)!.case_types.length);
// The case types named by the most firms, counted across the pages rather than asserted.
const typeCounts = new Map<string, number>();
for (const f of publishers) {
  for (const t of new Set(rp(f)!.case_types)) typeCounts.set(t, (typeCounts.get(t) ?? 0) + 1);
}
const topTypes = [...typeCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 3).map(([t]) => t);
const topTypesList = topTypes.length > 1
  ? `${topTypes.slice(0, -1).join(', ')} and ${topTypes[topTypes.length - 1]}`
  : topTypes.join('');

const withDisclaimer = publishers.filter(f => rp(f)!.disclaimer === true);
const noDisclaimer = publishers.filter(f => rp(f)!.disclaimer === false);

// The other half of the story: what the directory itself holds. A result carries an amount on a
// profile only when it is marked verified, and that set is currently empty.
const resultEntries = firms.flatMap(f => f.data.results);
const verifiedResults = resultEntries.filter(r => r.verified);

// Pillar B, quoted from the same records the profiles print rather than from the methodology page.
const bMax = firms.find(f => f.data.score)?.data.score!.pillars.B.max ?? 0;
const bPending = firms.filter(f =>
  f.data.score?.pillars.B.subs.some(s => s.source === 'pending')).length;
const bZero = firms.filter(f => f.data.score?.pillars.B.score === 0).length;
// B1 pays its top band at 25 published results, so this is the set for which further publishing
// earns nothing at all.
const B1_TOP_BAND = 25;
const topBand = publishers.filter(f => rp(f)!.count! >= B1_TOP_BAND);
// The distribution in the bands B1 actually pays on, so the chart shows where the rule bites
// rather than only the shape. Bands are drawn from the same constant the sub-factor uses.
const BANDS = [
  { label: 'Under 10', lo: 1, hi: 9 },
  { label: '10 to 24', lo: 10, hi: 24 },
  { label: '25 to 49', lo: 25, hi: 49 },
  { label: '50 or more', lo: 50, hi: Infinity },
];
const bandColumns = BANDS.map(b => ({
  label: b.label,
  value: publishers.filter(f => rp(f)!.count! >= b.lo && rp(f)!.count! <= b.hi).length,
  emphasis: b.lo >= B1_TOP_BAND,
}));

const avgTotal = (xs: Firm[]) => xs.length
  ? +(xs.reduce((n, f) => n + (f.data.score?.total ?? 0), 0) / xs.length).toFixed(1) : 0;
const nonPublishers = firms.filter(f => !publishers.includes(f));
const avgPublishers = avgTotal(publishers);
const avgNonPublishers = avgTotal(nonPublishers);

// By state, because the rule about disclaimers people quote is New York's and the directory is
// no longer only New York. Built from the firms, so a new market appears here by itself.
const states = [...new Set(firms.map(f => f.data.market.state))]
  .map(code => {
    const inState = firms.filter(f => f.data.market.state === code);
    const pubs = inState.filter(f => publishers.includes(f));
    return {
      code,
      name: inState[0].data.market.state_name,
      firms: inState.length,
      publishing: pubs.length,
      disclaimer: pubs.filter(f => rp(f)!.disclaimer === true).length,
    };
  })
  .sort((a, b) => b.firms - a.firms);

// Two firms the data itself nominates: the one that publishes the most, and one whose page we
// could not read, which is a limit on us rather than a finding about them.
const blocked = unreadable.find(f => rp(f)!.why);

const readDates = checked.map(f => rp(f)!.checked_at).sort();
const updated = readDates.length
  ? new Date(readDates[readDates.length - 1]).toLocaleDateString('en-US',
    { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : null;

// The headline states the study's finding rather than its subject, which is the difference
// between a piece somebody clicks and a piece somebody scrolls past. It stays inside what the
// data shows: an amount with no court beside it cannot be looked up by anyone, and most of these
// pages carry the amount and not the court. No figure in it, because check_meta rejects a count
// in a title and it is right to: a title is indexed once and a count moves every month.
const title = 'New Study: The Court a Firm Names Matters More Than Its Number';
const description = 'We read the case results page of every firm we list and counted what is on it: what those pages show, what they leave out, and why we repeat no amounts.';
---
<Base title={title} description={description} nav="guides" image="/og/results.png" imageAlt="Bars standing for the case results firms publish, three of them marked as checkable, beside a verification seal left open">
<article>
<header class="article-head">
  <div class="narrow">
    <ol class="crumbs"><li><a href="/">Home</a></li><li><a href="/guides/">Guides</a></li><li aria-current="page">Case results pages</li></ol>
    <span class="eyebrow" style="margin-top:18px">Method · Published results</span>
    <h1>{title}</h1>
    <p class="lede">Almost every injury firm publishes a page of settlements and verdicts, and it is the page prospective clients read hardest. We read all of them. Across the {firms.length} firms in this directory, {publishers.length} publish at least one result, {totalResults.toLocaleString('en-US')} results in total. We have confirmed {verifiedResults.length === 0 ? 'none of them' : `${verifiedResults.length} of them`} against a court record, which is why no figure from those pages appears on this site.</p>
    <div class="byline">
      <div class="who"><span class="av" aria-hidden="true"></span><div><b>By the Law Firm Listings Editorial Team</b>Measured data, no legal content</div></div>
      {updated && <><span class="sep" aria-hidden="true"></span><span>Read {updated}</span></>}
      <span class="sep" aria-hidden="true"></span>
      <span>5 min read</span>
    </div>
  </div>
</header>

<GuideCover name="results" />

<div class="container article-grid">
  <nav class="toc" aria-label="On this page">
    <h4>On this page</h4>
    <ol>
      <li><a href="#what" class="is-active">What we counted</a></li>
      <li><a href="#found">What the pages carry</a></li>
      <li><a href="#amounts">Why this page prints no figures</a></li>
      <li><a href="#score">What our own pillar B measures</a></li>
      <li><a href="#read">Reading a results page yourself</a></li>
    </ol>
  </nav>

  <div class="prose">
    <div class="callout"><b>How to read this.</b> Every figure on this page is computed at build time from what each firm publishes on its own website, so it changes when the data does. It describes what firms say about their results, not what their results were. Nothing here is legal information or advice.</div>

    <h2 id="what">What we counted</h2>
    <p>A case results page is a firm's own account of its own work. There is nothing wrong with that, and a firm with a long record should say so.</p>
    <p><b>The question is what a reader can actually do with the page.</b> The only way to answer it is to read every one of them and count what is on it.</p>
    <p>So we fetched the results page of each of the {firms.length} firms in the directory, honoring robots.txt, and recorded five things: how many results the page lists, what kinds of case they are attributed to, whether any court or county is named, whether the page carries a prior-results disclaimer, and whether we could read the page at all.</p>
    <p>That last one matters more than it sounds.</p>
    <StackBar
      heading={`What the results page of each of the ${firms.length} firms gave us`}
      unit="firms"
      segments={[
        { label: 'Publish at least one case result', value: publishers.length },
        { label: 'Readable page, nothing on it to count', value: silent.length },
        { label: 'Page we could not read', value: unreadable.length },
        { label: 'Not yet checked', value: unchecked.length },
      ]}
      caption="One bar, every firm in the directory. Read dark to light: the darkest segment is the firms whose page told us something, the lightest is our own unfinished work."
    />
    <p>We treat the {unreadable.length === 1 ? 'page' : `${unreadable.length} pages`} we could not read as a limit on our crawler rather than as a finding about the {unreadable.length === 1 ? 'firm' : 'firms'}.{' '}{blocked && <>{blocked.data.name}'s page, for instance, answers us with a refusal: our note on that record reads "{rp(blocked)!.why}". <a href={`/firms/${blocked.data.slug}/`}>Its profile</a> leaves pillar B unscored rather than scoring it zero.</>}</p>
    <p><b>A page we cannot read leaves the sub-factor out of the denominator</b>, because a firm must not lose points to the reach of our own crawl. That is the rule everywhere on this site. {bPending} {bPending === 1 ? 'firm has' : 'firms have'} pillar B unscored for that reason.</p>
    <p>The {silent.length} firms with a readable page and nothing countable on it are a different case, and a real finding. <b>They have built the page, linked it in the navigation, and put no result on it that a reader or a search engine receives.</b></p>

    <h2 id="found">What the pages carry</h2>
    <p>Across the {publishers.length} firms that do publish, the pages hold {totalResults.toLocaleString('en-US')} results between them. The median firm publishes {medianCount}. {most && <><a href={`/firms/${most.data.slug}/`}>{most.data.name}</a> publishes {rp(most)!.count}, the most of anyone here.</>}</p>
    <ColumnChart
      heading={`How many results each of the ${publishers.length} publishing firms lists`}
      columns={bandColumns}
      emphasisLabel={`At or above ${B1_TOP_BAND} results, where our own B1 sub-factor stops paying more`}
      quietLabel="Below it, where publishing one more result still earns something"
      caption={`Median ${medianCount} results per firm. The two right-hand bands earn identical points, which is the part of our method this piece argues with.`}
    />
    <BarChart
      heading={`What those ${publishers.length} pages carry`}
      max={publishers.length}
      rows={[
        { label: 'Name the kinds of case', value: withCaseTypes.length, display: `${withCaseTypes.length} of ${publishers.length}` },
        { label: 'Attach a figure to individual results', value: withAmounts.length, display: `${withAmounts.length} of ${publishers.length}` },
        { label: 'State a lifetime or aggregate total', value: withAggregate.length, display: `${withAggregate.length} of ${publishers.length}` },
        { label: 'Name a court or county', value: withVenue.length, display: `${withVenue.length} of ${publishers.length}` },
        { label: 'Carry a prior-results disclaimer', value: withDisclaimer.length, display: `${withDisclaimer.length} of ${publishers.length}` },
      ]}
      caption="Each bar is the share of publishing firms whose page carries that thing. Case types are close to universal; a court or county is not."
    />
    <p>Case types are close to universal, and they are the most useful thing on the page. A firm whose results are all rear-end collisions has told you very little about a birth injury case. Across these pages, the types named by the most firms are {topTypesList}.</p>
    <p>Venue is where it thins out. {withVenue.length} of the {publishers.length} name a court or a county anywhere on the page, and even then the reference usually sits beside the page as a whole rather than beside a particular figure.</p>
    <p><b>A settlement with no court, no year and no case number cannot be looked up by anyone, including us.</b></p>
    <p>Disclaimers split the set nearly in half: {withDisclaimer.length} pages carry one, {noDisclaimer.length} do not. New York's attorney advertising rules effectively require the line on a page that advertises past results, and most of these firms are in New York.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>State</th><th>Firms</th><th>Publishing results</th><th>With a disclaimer</th></tr></thead>
        <tbody>
          {states.map(s => (
            <tr>
              <td>{s.name}</td>
              <td class="num">{s.firms}</td>
              <td class="num">{s.publishing}</td>
              <td class="num">{s.disclaimer}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>The states are not evenly covered, so read that table as a description of this directory rather than of any state's bar. Most of what we have measured so far is <a href="/cities/new-york-ny/personal-injury/">New York injury firms</a>, and the other markets are early.</p>

    <h2 id="amounts">Why this page prints no figures</h2>
    <p>We hold {amountsCount.toLocaleString('en-US')} dollar figures taken off these pages. <b>We publish none of them.</b> Not on this page, not on the profiles, not in the rankings.</p>
    <p>The reason is that we have verified {verifiedResults.length === 0 ? 'none' : verifiedResults.length} of them.</p>
    <p>Verifying a published result means matching it to a docket or to documentation: the court, the case number, the date, the disposition. Our records have fields for exactly that, and {resultEntries.length === 0 ? 'not one firm in the directory has a result in them yet' : `${resultEntries.length} results are in them so far`}.</p>
    <p>Until a result is in that state, repeating the number would make us a louder version of the firm's own marketing, with the directory's name on it.</p>
    <p>There is a practical reason too. Reading figures off a page mechanically is unreliable.{billionScale > 0 && <> {billionScale === 1 ? 'One of the figures' : `${billionScale} of the figures`} we extracted {billionScale === 1 ? 'is' : 'are'} in the billions, which is far likelier to be two numbers welded together, or a lifetime total sitting next to a single case, than a recovery of that size.</>}</p>
    <p>A count of what is on a page survives that kind of error. <b>A dollar amount does not.</b></p>
    <div class="callout"><b>This is not an accusation.</b> Nothing here says a published figure is false, and we have no reason to doubt any particular one. Firms are subject to advertising rules about what they claim. The claim is narrower and it is about us: we cannot confirm them, so we do not repeat them, and neither should any directory that has not done the checking.</div>
    <p>A firm that wants its results on this site with the amounts attached can <a href="/list-your-firm/">claim its profile</a> and submit them with the documentation. That is the only route, it is free, and it is the same route for everyone.</p>

    <h2 id="score">What our own pillar B measures</h2>
    <p>Pillar B of the <a href="/methodology/">LFL Certification Score</a> is worth {bMax} of 100, and it is named for verified outcomes. <b>It does not measure them.</b></p>
    <p>It measures what a firm publishes about its outcomes, in three sub-factors: how many results are on the page, how specific they are, and whether the page carries a disclosure. We say so on the methodology page, and it is worth saying plainly here too, because the pillar's name promises more than the pillar delivers.</p>
    <p>The sharpest edge of that is the first sub-factor. It pays its top band at {B1_TOP_BAND} published results, so the {topBand.length} firms at or above that number earn the same points, whether they publish {B1_TOP_BAND} results or {most ? rp(most)!.count : B1_TOP_BAND}.</p>
    <p>Publishing more unverified figures past that point earns nothing, which is deliberate. <b>But it does mean a firm that posts many unverifiable figures scores above a firm that posts a handful it could document, and that is the wrong way around.</b></p>
    <p>It shows up in the totals. The {publishers.length} firms that publish results average {avgPublishers} out of 100. The {nonPublishers.length} that do not average {avgNonPublishers}.</p>
    <p>Some of that gap is pillar B directly, by construction: {bZero} firms score zero in it. The rest is probably the same thing that produces a results page in the first place, which is a firm large enough to maintain its own website. <b>Read the gap as an association, not as a measurement of lawyering.</b></p>
    <p>The honest summary is that pillar B currently rewards disclosure and penalizes silence, and that is a defensible thing for {bMax} points out of a hundred to do. It is not the same as knowing who wins. Verified results would need docket-by-docket reading, and where we have done none, the profile says so rather than implying otherwise.</p>
    <p>The averages above carry one more caveat. A firm whose results page we could not read keeps pillar B pending instead of scoring zero, which takes those points out of its denominator entirely, so the totals being averaged are not all shares of the same scale. <a href="/guides/what-a-law-firm-score-cannot-compare/">What that does to a comparison</a> is its own study.</p>

    <h2 id="read">Reading a results page yourself</h2>
    <p>The page is still worth reading. It is just worth reading for different things than the biggest number on it.</p>
    <ul>
      <li><b>Look for your own case type, not the headline figure.</b> The largest figure on a page is one case, and you are not that case. The kind of case is the part that transfers to yours. {withCaseTypes.length === publishers.length ? <>Every one of the {publishers.length} pages names its case types</> : <>{withCaseTypes.length} of the {publishers.length} pages name their case types</>}, so this is usually answerable in a minute.</li>
      <li><b>Check whether anything is attached to a court.</b> A result with a county, a year and a case number can be looked up at the courthouse or through the state's case search. Most cannot, and a firm that publishes them anyway is publishing an advertisement, which is lawful and is not evidence.</li>
      <li><b>Ask how many of these the firm tried.</b> Settlements and verdicts sit on the same page and are not the same achievement. Which of the two a result was is usually not stated, and the firm will tell you on the call.</li>
      <li><b>Ask for the denominator.</b> A results page is a selection the firm made from its own record. How many cases sit behind the ones shown, and how long they took, is not the sort of thing these pages carry. It is a fair question on the free call, and no firm should mind it.</li>
      <li><b>Weigh it against things you can check.</b> What the firm publishes about fees and what its clients say are both verifiable to some degree. We measured <a href="/guides/what-new-york-injury-firms-publish-about-fees/">what these firms publish about fees</a> and <a href="/guides/google-reviews-new-york-injury-firms/">what their Google reviews are worth</a>, and both hold up better than a settlement figure.</li>
    </ul>
    <p>Every profile in the <a href="/practice-areas/personal-injury/">personal injury directory</a> shows the count and the case types we read off that firm's page, with a link to the page itself and the date we read it. No amounts, for the reason above. If we have got a count wrong, the firm can <a href="/contact/">tell us</a> and we will read the page again.</p>
    <p class="muted" style="font-size:.86rem">Results pages are read by crawling each firm's own public site and honoring robots.txt, and each record stores the page URL and the date it was read. Every page is re-read monthly and this study recomputes itself from whatever the new reading says, so the figures above move without anyone editing the sentences around them. The date in the byline is the most recent read. A page we cannot read leaves pillar B unscored rather than scoring the firm zero. Amounts are stored but never published: only a result verified against a court record or documentation is shown with its figure, and there are {verifiedResults.length === 0 ? 'none' : verifiedResults.length} at present.</p>
  </div>

  <aside class="article-aside">
    <div class="panel panel--ink">
      <h4>See what each firm publishes</h4>
      <p>Every profile shows the results count, the case types and the source page we read, with the date.</p>
      <a class="btn btn--white" href="/cities/new-york-ny/personal-injury/">New York injury firms</a>
    </div>
    <div class="panel">
      <h4>Related</h4>
      <ul>
        <li><a href="/methodology/">LFL Certified Methodology</a></li>
        <li><a href="/guides/what-new-york-injury-firms-publish-about-fees/">What firms publish about fees</a></li>
        <li><a href="/guides/core-web-vitals-new-york-injury-firms/">Core Web Vitals, measured</a></li>
        <li><a href="/guides/what-a-law-firm-score-cannot-compare/">What a score cannot compare</a></li>
      </ul>
    </div>
  </aside>
</div>
</article>
</Base>
