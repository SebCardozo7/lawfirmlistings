---
import Base from '../../layouts/Base.astro';
import GuideCover from '../../components/GuideCover.astro';
import BarChart from '../../components/BarChart.astro';
import ColumnChart from '../../components/ColumnChart.astro';
import Takeaways from '../../components/Takeaways.astro';
import offices from '../../data/research/law-offices-ny.json';
import register from '../../data/research/attorney-register-ny.json';

/**
 * A reference article, like how-many-lawyers-in-new-york.astro and unlike the nine studies: the
 * figures are the federal payroll record's rather than our own measurements, and the page makes
 * no claim about the firms in this directory.
 *
 * It reads both research files on purpose. One counts lawyers and the other counts law offices,
 * and the interesting number is the difference: New York holds more resident licensed attorneys
 * than its law offices employ people. Neither figure is wrong. A licence is not a job.
 *
 * No figure below is a literal. scripts/fetch_firm_stats.py pulls the series and the counties
 * from QCEW and writes them with the year they belong to, so re-running it moves this page
 * forward a year, and the same article for another state is another run of it.
 */
const n = (v: number) => v.toLocaleString('en-US');
const series = offices.series;
const latest = series[series.length - 1];
const first = series[0];
const bls = offices.citations[0];

const officeChange = latest.law_offices.establishments - first.law_offices.establishments;
const jobChange = latest.law_offices.employment - first.law_offices.employment;
const wageGrowth = Math.round(
  ((latest.law_offices.avg_weekly_wage / first.law_offices.avg_weekly_wage) - 1) * 100);
const peak = series.reduce((a, b) =>
  (b.law_offices.establishments > a.law_offices.establishments ? b : a));
const perOffice = latest.law_offices.employment / latest.law_offices.establishments;
// Wages to the nearest billion, which is the precision the sentence can carry: the exact
// figure is 12 digits and nobody reads one.
const wageBillions = Math.round(latest.law_offices.annual_wages / 1e9);

// The wider industry, which is not all law firms. The gap is the part of the legal economy that
// is a title company or a process server rather than a practice.
const wider = latest.legal_services;
const notFirms = wider ? wider.establishments - latest.law_offices.establishments : 0;

// Counties, with the row BLS cannot place excluded from the ranking and reported separately: an
// establishment it could not assign to a county is not a county.
const placed = offices.counties.filter(c => !c.unallocated && !/unknown|undefined/i.test(c.county));
const unplaced = offices.counties.find(c => c.unallocated || /unknown|undefined/i.test(c.county));
const manhattan = placed[0];
const officeShare = Math.round((manhattan.establishments / latest.law_offices.establishments) * 100);
const jobShare = Math.round((manhattan.employment / latest.law_offices.employment) * 100);

const countyRows = placed.slice(0, 12).map(c => ({
  label: c.county,
  value: c.establishments,
  display: n(c.establishments),
  note: `${n(c.employment)} people, $${n(c.avg_weekly_wage)} a week`,
  emphasis: c === manhattan,
}));

// Pay, ranked, over the same counties. A separate chart because it is a different fact and
// ordering the offices chart by pay would hide the concentration the first one is about.
const payRows = [...placed.slice(0, 12)]
  .sort((a, b) => b.avg_weekly_wage - a.avg_weekly_wage)
  .map(c => ({
    label: c.county,
    value: c.avg_weekly_wage,
    display: `$${n(c.avg_weekly_wage)}`,
    note: `${n(c.establishments)} offices`,
    emphasis: c === manhattan,
  }));
const cheapest = payRows[payRows.length - 1];
const payRatio = (manhattan.avg_weekly_wage / cheapest.value).toFixed(1);

const officeColumns = series.map(y => ({
  label: String(y.year),
  value: y.law_offices.establishments,
  note: y.year === peak.year ? 'peak' : undefined,
  emphasis: y.year === latest.year,
}));
const jobColumns = series.map(y => ({
  label: String(y.year),
  value: y.law_offices.employment,
  emphasis: y.year === latest.year,
}));

// The other research file. Attorneys with a live registration and a New York address, against
// the people its law offices actually employ.
const residentAttorneys = register.counts.current_in_state.value;
const moreLicensed = residentAttorneys - latest.law_offices.employment;

const measured = new Date(offices.measured_at).toLocaleDateString('en-US',
  { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// The headline is computed rather than typed, which is the only way a figure belongs in one.
// A number in an indexed title goes stale the moment the source updates, and this dataset
// publishes a new year every year; deriving it means the year the page ships is the year the
// title claims, and nobody has to remember to come back and edit it.
//
// The shape is the one the trade press uses for a study: the finding is the headline and the
// scale is the credential, rather than the subject followed by a colon. "Law firm statistics"
// stays in it because that is the phrase somebody types.
const title = `Law Firm Statistics: New York Lost ${Math.abs(officeChange)} Offices, Gained ${n(jobChange)} Jobs`;
const description = `New York has ${n(latest.law_offices.establishments)} law offices, ${Math.abs(officeChange)} fewer than ten years ago. They employ ${n(jobChange)} more people than they did, and pay them ${wageGrowth}% more a week.`;
---
<Base title={title} description={description} nav="guides"
  figuresFrom={`${offices.dataset}, read ${measured}`} image="/og/ranking.png"
  imageAlt="A row of doorways thinning across ten years while the stacks of people above them grow taller">
<article>
<header class="article-head">
  <div class="narrow">
    <ol class="crumbs"><li><a href="/">Home</a></li><li><a href="/guides/">Guides</a></li><li aria-current="page">Law firm statistics</li></ol>
    <span class="eyebrow" style="margin-top:18px">Reference · Public statistics</span>
    <h1>{title}</h1>
    <p class="lede">The number of law offices in New York has fallen every few years for a decade. The number of people working in them has not. We pulled ten years of the federal payroll record and the two lines go in opposite directions: <b>{Math.abs(officeChange)} fewer offices</b>, <b>{n(jobChange)} more jobs</b>, and <b>{wageGrowth}% more</b> in the average weekly pay packet. Here is what that looks like, county by county.</p>
    <div class="byline">
      <div class="who"><span class="av" aria-hidden="true"></span><div><b>By the Law Firm Listings Editorial Team</b>Public statistics, no legal content</div></div>
      <span class="sep" aria-hidden="true"></span><span>Read {measured}</span>
      <span class="sep" aria-hidden="true"></span><span>6 min read</span>
    </div>
  </div>
</header>

<GuideCover name="offices" />

<div class="container article-grid">
  <nav class="toc" aria-label="On this page">
    <h4>On this page</h4>
    <ol>
      <li><a href="#shrinking" class="is-active">The two lines that diverge</a></li>
      <li><a href="#where">Manhattan takes 60% of the jobs</a></li>
      <li><a href="#pay">A 2.9x pay gap inside one state</a></li>
      <li><a href="#licences">More lawyers than legal jobs</a></li>
      <li><a href="#count">What counts as a law firm here</a></li>
      <li><a href="#limits">Three things this misses</a></li>
    </ol>
  </nav>

  <div class="prose">
    <Takeaways
      scope={`${offices.dataset}, published by ${offices.publisher}. Series ${first.year} to ${latest.year}, read ${measured}.`}
      items={[
        `New York has <b>${n(latest.law_offices.establishments)}</b> law offices employing <b>${n(latest.law_offices.employment)}</b> people, who were paid <b>$${wageBillions} billion</b> between them in ${latest.year}.`,
        `The count of offices is <b>${Math.abs(officeChange)} ${officeChange < 0 ? 'lower' : 'higher'}</b> than ten years ago and employment is <b>${n(Math.abs(jobChange))} ${jobChange > 0 ? 'higher' : 'lower'}</b>. The average office now holds <b>${perOffice.toFixed(1)}</b> people.`,
        `<b>${manhattan.county}</b> holds ${officeShare}% of the offices and <b>${jobShare}%</b> of the jobs, and pays <b>${payRatio} times</b> what the lowest-paying county on this list does.`,
        `The state has <b>${n(residentAttorneys)}</b> resident attorneys with a live registration, <b>${n(moreLicensed)}</b> more than its law offices employ people. A licence is not a job.`,
      ]}
    />
    <div class="callout"><b>How to read this.</b> Every figure here is aggregated from the federal payroll record, which counts offices that report payroll rather than firms: a practice with four offices is four of these. Nothing here is legal information or advice.</div>

    <h2 id="shrinking">The two lines that diverge</h2>
    <p>Start with the doors. New York had {n(first.law_offices.establishments)} law offices in {first.year}. It has {n(latest.law_offices.establishments)} now, and the peak was {peak.year}.</p>
    <ColumnChart
      heading={`Law offices in New York, ${first.year} to ${latest.year}`}
      columns={officeColumns}
      emphasisLabel={`${latest.year}, the latest year published`}
      quietLabel="earlier years"
      caption="Annual averages of establishments reporting payroll under NAICS 541110."
    />
    <p>It fell for four straight years after that peak and it has not recovered. {latest.year} is still <b>{n(peak.law_offices.establishments - latest.law_offices.establishments)} offices below</b> where the state was in {peak.year}.</p>
    <p>Now the people.</p>
    <ColumnChart
      heading={`People employed in those offices, ${first.year} to ${latest.year}`}
      columns={jobColumns}
      emphasisLabel={`${latest.year}, the latest year published`}
      quietLabel="earlier years"
      caption="The same establishments, counted by the people on their payroll."
    />
    <p>Employment went the other way. It dipped in 2020 and 2021, which needs no explaining, then passed its old level: <b>{n(latest.law_offices.employment)}</b> people against {n(first.law_offices.employment)} ten years earlier.</p>
    <p>Put the two charts together and you get the finding. The average New York law office has grown from <b>{(first.law_offices.employment / first.law_offices.establishments).toFixed(1)} people to {perOffice.toFixed(1)}</b>.</p>
    <p>That is consolidation, and it is the most useful line on this page if you are choosing a lawyer. The profession is arranging itself into fewer, larger practices, and the small firm is a smaller share of the market than it was a decade ago.</p>

    <h2 id="where">Manhattan takes {jobShare}% of the jobs</h2>
    <BarChart
      heading={`Law offices by county, ${latest.year}, top ${countyRows.length}`}
      rows={countyRows}
      caption="Counties as the Bureau of Labor Statistics names them. Kings is Brooklyn, Richmond is Staten Island, and New York County is Manhattan."
    />
    <p>{manhattan.county} has <b>{officeShare}%</b> of the offices and <b>{jobShare}%</b> of the jobs. That gap is the whole story of this market.</p>
    <p>The offices are spread across the state. The big ones are not. An average {manhattan.county} office holds <b>{(manhattan.employment / manhattan.establishments).toFixed(1)} people</b>; in {placed[1].county}, next on the list, it holds {(placed[1].employment / placed[1].establishments).toFixed(1)}.</p>
    {unplaced && (
      <p>A further {n(unplaced.establishments)} establishments are recorded statewide without a county, which the Bureau labels {unplaced.county.toLowerCase()}. They are left out of the ranking above rather than assigned somewhere, because an establishment nobody could place is not a county.</p>
    )}

    <h2 id="pay">The same job pays {payRatio} times more in one county</h2>
    <BarChart
      heading={`Average weekly wage in a law office, ${latest.year}`}
      rows={payRows}
      caption="The same counties, ranked by pay instead of by size. The note is how many offices the average is taken over."
    />
    <p>A week in a {manhattan.county} law office pays <b>${n(manhattan.avg_weekly_wage)}</b>. The same week in {cheapest.label} pays <b>${n(cheapest.value)}</b>. Same industry code, same state, <b>{payRatio} times</b> the money.</p>
    <p>Some of that is seniority and some of it is the work. The corporate deals are in Manhattan. The closings and the injury cases are everywhere.</p>
    <p>For national context, the <a href={bls.url} rel="noopener" target="_blank">{bls.who}</a> puts the median annual wage for lawyers at <b>${n(bls.value)}</b> as of {bls.what.replace('Occupational Outlook Handbook, ', '')}. That is a different measure again: it counts people whose occupation is lawyer, wherever they work, while everything above counts everybody on a law office's payroll including the people who are not lawyers.</p>

    <h2 id="licences">There are more lawyers than legal jobs</h2>
    <p>New York's own register of attorneys holds <b>{n(residentAttorneys)}</b> live registrations with a New York address. Its law offices employ <b>{n(latest.law_offices.employment)}</b> people, and not all of those are lawyers.</p>
    <p>So New York has at least <b>{n(moreLicensed)}</b> more resident licensed attorneys than people working in its law offices. They are in-house, in government, on the bench, teaching, retired but still registered, or doing something else entirely.</p>
    <p>If you have ever wondered how a state reports a record number of lawyers in the same decade its law firms shrink, that is the answer.</p>
    <p>We have written separately about <a href="/guides/how-many-lawyers-in-new-york/">what that register does and does not say</a>, including the four different answers it gives to how many lawyers the state has.</p>

    <h2 id="count">What counts as a law firm here</h2>
    <p>Nobody counts law firms. What gets counted is establishments that report payroll, and that is what every figure above is.</p>
    <p>It is not a count of firms. A practice with four offices files as four establishments, so the real number of firms is lower than {n(latest.law_offices.establishments)} and nothing published says by how much.</p>
    {wider && (
      <p>The wider industry code, legal services, has <b>{n(wider.establishments)}</b> establishments in the same year. The <b>{n(notFirms)}</b> that are not offices of lawyers are title abstract offices, notaries, process servers and the rest of the legal economy that is not a law practice. This page uses the narrower code throughout.</p>
    )}

    <h2 id="limits">Three things this misses</h2>
    <p><b>It counts offices, not firms.</b> Nothing published reconciles the two, so the number of law firms in New York is smaller than {n(latest.law_offices.establishments)} by an amount nobody measures.</p>
    <p><b>It misses practices with no payroll.</b> A solo practitioner who employs nobody may not appear at all, which means the smallest end of the profession is the part this dataset sees least.</p>
    <p><b>It says nothing about quality, and neither does any count.</b> A county with more offices is not a county with better lawyers. What a firm publishes about itself is checkable and is a different question, which is <a href="/methodology/">the one this directory measures</a>.</p>
  </div>
</div>
</article>
</Base>
