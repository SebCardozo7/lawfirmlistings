---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import FirmCard from '../../components/FirmCard.astro';

const PRACTICE = 'personal-injury';

// Every firm and every count on this page comes from the collection, so a data correction
// propagates here. Sample firms are excluded outright rather than gated on LFL_ENV: this is a
// public ranked list, and fictional firms must never appear in one.
const matching = await getCollection('firms', f =>
  f.data.status !== 'sample' &&
  f.data.status !== 'not_eligible' &&
  f.data.practices.some(p => p.slug === PRACTICE));

// Certified firms rank by score; listed firms have no score yet and follow, alphabetically.
const weight = (f: typeof matching[number]) =>
  f.data.status === 'certified' ? -(f.data.score?.total ?? 0) : 1;
const firms = matching.sort((a, b) => weight(a) - weight(b) || a.data.name.localeCompare(b.data.name));

const certified = firms.filter(f => f.data.status === 'certified');
const cities = [...new Set(firms.map(f => `${f.data.market.city}, ${f.data.market.state}`))];
const contingency = firms.filter(f => /contingency/i.test(f.data.fee_model)).length;
const freeConsult = firms.filter(f => f.data.free_consultation).length;
const share = (n: number) => (firms.length ? `${Math.round((100 * n) / firms.length)}%` : '—');
const logoVariants = ['', 'l2', 'l3'];

// "Updated" reflects the newest score the engine actually wrote, not a hand-typed month.
const computedDates = firms.map(f => f.data.score?.computed_at).filter(Boolean) as string[];
const lastUpdated = computedDates.length
  ? new Date(computedDates.sort().at(-1)!).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
  : null;

// Cities that actually have a firm in this practice, with their real counts.
const cityCounts = [...new Set(firms.map(f => f.data.market.city_slug))].map(slug => {
  const inCity = firms.filter(f => f.data.market.city_slug === slug);
  return { slug, label: `${inCity[0].data.market.city}, ${inCity[0].data.market.state}`, count: inCity.length };
}).sort((a, b) => b.count - a.count);
---
<Base title="Personal Injury Law Firms — Rankings & Hiring Guide" description={`How to choose a personal injury firm, and where our rankings are published. ${firms.length} ${firms.length === 1 ? 'firm' : 'firms'} measured on verified offices, client reviews, fee terms and site performance across ${cities.length === 1 ? cities[0] : `${cities.length} cities`}. No firm can pay to rank.`} nav="practice">
<section class="page-hero on-night">
  <div class="aurora" aria-hidden="true"><i class="b1"></i><i class="b2"></i><i class="b3"></i></div>
  <div class="container">
    <div>
      <ol class="crumbs"><li><a href="/">Home</a></li><li><a href="/practice-areas/">Practice Areas</a></li><li aria-current="page">Personal Injury</li></ol>
      <span class="eyebrow">Practice area</span>
      <h1>Personal Injury Law Firms</h1>
      <p class="lede">Personal injury firms handling car accidents, slip and fall, medical malpractice, construction injuries and wrongful death. Every firm is checked for active licensure, clean disciplinary history and verified case results. Rankings are published per city, because a firm is worth comparing against the firms someone could actually hire instead of it — {cities.length === 1 ? <>so far that means {cities[0]}</> : <>so far that means {cities.length} cities</>}.</p>
      <div class="chips" style="margin-top:24px">
        {/* Sub-topics of this practice area. None has a page yet, so they describe the scope
            without pretending to be navigation. */}
        {['Car accidents', 'Truck accidents', 'Slip & fall', 'Medical malpractice',
          'Construction injuries', 'Wrongful death', 'Product liability'].map(t => (
          <span class="chip soon">{t}</span>
        ))}
      </div>
    </div>
    <div class="hero-facts">
      <div class="fact"><b class="num">{certified.length}</b><span>Certified PI firms</span></div>
      <div class="fact"><b class="num">{firms.length}</b><span>Firms listed</span></div>
      <div class="fact"><b class="num">{share(contingency)}</b><span>Work on contingency</span></div>
      <div class="fact"><b class="num">{share(freeConsult)}</b><span>Free consultation</span></div>
      <div class="fact"><b class="num">{cities.length}</b><span>{cities.length === 1 ? 'City covered' : 'Cities covered'}</span></div>
    </div>
  </div>
</section>

<div class="filterbar">
  <div class="container">
    <span class="lbl">City</span>
    {/* Eight cities were listed here and seven had no page. The filter now offers the cities
        that hold firms, and the sort control is left out until it does something. */}
    {cityCounts.map(c => <a class="chip" href={`/cities/${c.slug}/${PRACTICE}/`}>{c.label.split(',')[0]}</a>)}
  </div>
</div>

<section class="section--tight">
  <div class="container layout">
    <div>
      {/* This page is the national view of the practice. The ranked list lives at
          /cities/<city>/<practice>/, because ranking is scoped to a city in the methodology
          and this URL claims the country. Showing the same thirteen firms here and there was
          two pages of near-identical content, and neither answered "personal injury lawyer
          NYC". A short teaser stays so the page is not an index of indexes. */}
      <div class="results-head">
        <h2>Highest-scoring firms in the practice</h2>
        <span class="num">{firms.length === 0
          ? 'No firms published yet'
          : `Top ${Math.min(3, firms.length)} of ${firms.length}${lastUpdated ? ` · updated ${lastUpdated}` : ''}`}</span>
      </div>
      <div class="firm-list">
        {firms.slice(0, 3).map((firm, i) => (
          <FirmCard firm={firm} rank={i + 1} logoVariant={logoVariants[i % logoVariants.length]} />
        ))}
      </div>
      {cityCounts.length > 0 && (
        <div class="ranked-links">
          <h3>Ranked lists by city</h3>
          <ul>
            {cityCounts.map(c => (
              <li><a href={`/cities/${c.slug}/${PRACTICE}/`}>Personal injury firms in {c.label}</a><span class="num">{c.count} {c.count === 1 ? 'firm' : 'firms'}</span></li>
            ))}
          </ul>
        </div>
      )}
      {firms.length === 0 && (
        <div class="callout"><b>Nothing published here yet.</b> The New York personal injury cohort is still in verification. Firms appear once their eligibility gates are checked.</div>
      )}
    </div>

    <aside class="sidebar">
      <div class="panel panel--ink">
        <h4>Not sure which firm fits?</h4>
        <p>Tell us what happened and we'll match you with up to three certified firms in your city — free, and without sharing your details until you say so.</p>
        {/* No matching service exists yet, so the panel describes it without a dead button. */}
        <span class="btn btn--white soon">Get matched in 2 minutes</span>
      </div>
      <div class="panel">
        <h4>Related guides</h4>
        <ul>
          <li><a href="/guides/core-web-vitals-new-york-injury-firms/">Almost every New York injury firm fails Core Web Vitals</a></li>
          {['Best personal injury firms in NYC', 'How contingency fees work',
            'What is my injury case worth?', 'Statute of limitations by state'].map(t => (
            <li><span class="soon">{t}</span></li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</section>

<section class="section section--paper">
  <div class="narrow prose">
    <span class="eyebrow">Hiring guide</span>
    <h2 style="margin-top:14px">How to choose a personal injury law firm</h2>
    <p>Personal injury is one of the few areas of law where the firm you choose can change the outcome by hundreds of thousands of dollars. Insurance carriers track which firms actually try cases — and they make higher offers to the ones that do. When comparing firms on this page, weigh the following.</p>
    <h3>A trial record, not just a settlement history</h3>
    <p>Most injury cases settle, but the firms that settle for the most are the ones prepared to go to verdict. Look for recent jury verdicts in your county, not just cumulative "recovered" totals.</p>
    <h3>Focus on your type of injury</h3>
    <p>A firm that handles hundreds of rear-end collisions may not be the right choice for a birth-injury or trucking case, which require specialized experts and much larger case budgets. Our tags show each firm's verified focus areas.</p>
    <h3>Direct access to a senior attorney</h3>
    <p>Ask who will actually handle your case. In high-volume firms, it may be a case manager. The firms ranked highest here commit to a named attorney returning calls within one business day.</p>
    <h3>Contingency fees — and what's not included</h3>
    <p>Almost every certified PI firm charges 33⅓% pre-suit and up to 40% if the case goes to trial. Ask whether case expenses (experts, depositions, filing fees) are deducted before or after the fee is calculated; it can make a five-figure difference.</p>
    <div class="callout"><b>Deadline warning.</b> Statutes of limitations for injury claims range from one year (Tennessee, Louisiana) to six (Maine). Claims against government entities often require a notice within 90 days. Consult a firm as early as possible.</div>
  </div>
</section>

<section class="section">
  <div class="narrow">
    <span class="eyebrow">Frequently asked</span>
    <h2 style="margin:14px 0 28px">Personal injury law firm FAQ</h2>
    <div class="faq">
      <details open><summary>How much does a personal injury lawyer cost?</summary><div>Nearly all certified personal injury firms work on a contingency fee, typically 33⅓% of the recovery if the case settles before a lawsuit is filed and 35–40% if it goes to litigation or trial. You pay nothing up front and nothing if there is no recovery.</div></details>
      <details><summary>How do I know if a firm is "certified"?</summary><div>Certified firms have passed our four-part review: active licensure for every named attorney, no public discipline in the past 10 years, at least three verified case results confirmed against court records, and a minimum of 25 verified client reviews with a 4.5+ average. Look for the gold LFL Certified badge.</div></details>
      <details><summary>Can law firms pay to rank higher on this page?</summary><div>No. The order comes from the Certification Score, and the score, the eligibility gates and the tier cannot be bought or edited — not even by a firm that manages its own profile. Claiming a profile is free and lets a firm keep its offices, fees and practice areas current. Sponsored placements are always labeled and never appear inside this list.</div></details>
      <details><summary>What is my personal injury case worth?</summary><div>It depends on medical costs, lost income, the severity and permanence of your injuries, and the insurance coverage available. Most firms listed here offer a free case evaluation that will give you a realistic range within a few days.</div></details>
      <details><summary>How long do I have to file a personal injury claim?</summary><div>Statutes of limitations range from one to six years depending on the state and the type of claim. Claims against a city, state or federal agency often have much shorter notice requirements — sometimes 90 days.</div></details>
    </div>
  </div>
</section>

</Base>
