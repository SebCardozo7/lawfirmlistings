---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import FirmCard from '../../components/FirmCard.astro';

const CITY_SLUG = 'new-york-ny';

// Firms, counts and borough tiles all derive from the collection. Sample firms are excluded
// outright: this is a public ranked list, and fictional firms must never appear in one.
const inCity = await getCollection('firms', f =>
  f.data.status !== 'sample' &&
  f.data.status !== 'not_eligible' &&
  f.data.market.city_slug === CITY_SLUG);

const weight = (f: typeof inCity[number]) =>
  f.data.status === 'certified' ? -(f.data.score?.total ?? 0) : 1;
const firms = inCity.sort((a, b) => weight(a) - weight(b) || a.data.name.localeCompare(b.data.name));

const certified = firms.filter(f => f.data.status === 'certified');
const freeConsult = firms.filter(f => f.data.free_consultation).length;
const multilingual = firms.filter(f => f.data.languages.some(l => l !== 'English')).length;
const share = (n: number) => (firms.length ? Math.round((100 * n) / firms.length) + '%' : '\u2014');
const logoVariants = ['', 'l2', 'l3'];

const computedDates = firms.map(f => f.data.score?.computed_at).filter(Boolean) as string[];
const lastUpdated = computedDates.length
  ? new Date(computedDates.sort().at(-1)!).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
  : null;

// Only practice areas that have a firm here AND a page to link to. Anything else would 404.
const PRACTICE_ICONS: Record<string, string> = { 'personal-injury': 'car' };
const practiceTiles = Object.keys(PRACTICE_ICONS).map(slug => {
  const matching = firms.filter(f => f.data.practices.some(pr => pr.slug === slug));
  const name = matching[0]?.data.practices.find(pr => pr.slug === slug)?.name ?? slug;
  return {
    slug, name, icon: PRACTICE_ICONS[slug], listed: matching.length,
    count: matching.filter(f => f.data.status === 'certified').length,
  };
}).filter(t => t.listed > 0);

// Borough presence comes from the offices each firm publishes, not from a guess.
const BOROUGHS = [
  { name: 'Manhattan', needle: 'Manhattan', cls: 'c1' },
  { name: 'Brooklyn', needle: 'Brooklyn', cls: 'c3' },
  { name: 'Queens', needle: 'Queens', cls: 'c4' },
  { name: 'The Bronx', needle: 'Bronx', cls: 'c7' },
  { name: 'Staten Island', needle: 'Staten Island', cls: 'c1' },
];
const boroughTiles = BOROUGHS
  .map(b => ({ ...b, count: firms.filter(f => f.data.offices.some(o => o.label.includes(b.needle))).length }))
  .filter(b => b.count > 0);
---
<Base title="Top Law Firms in New York, NY (2026)" description={`Law firms in New York City with verified offices, client reviews and fee terms. ${firms.length} ${firms.length === 1 ? 'firm' : 'firms'} listed across ${practiceTiles.length} ${practiceTiles.length === 1 ? 'practice area' : 'practice areas'}, ranked city by city rather than nationally.`} nav="cities">
<section class="page-hero on-night">
  <div class="aurora" aria-hidden="true"><i class="b1"></i><i class="b2"></i><i class="b3"></i></div>
  <div class="container">
    <div>
      <ol class="crumbs"><li><a href="/">Home</a></li><li><a href="#">Cities</a></li><li><a href="#">New York</a></li><li aria-current="page">New York City</li></ol>
      <span class="eyebrow">City guide</span>
      <h1>Top Law Firms in New York, NY</h1>
      <p class="lede">New York City is home to more than 80,000 practicing attorneys — and to some of the most complex courts in the country. {certified.length > 0 ? <>We have certified {certified.length} {certified.length === 1 ? 'firm' : 'firms'} here so far, starting with the personal injury cohort.</> : <>Our first New York cohort is still in verification.</>} Browse by what you need and compare what each firm publishes.</p>
      <div class="chips" style="margin-top:24px">
        <a class="chip" href="#">Manhattan</a><a class="chip" href="#">Brooklyn</a><a class="chip" href="#">Queens</a><a class="chip" href="#">The Bronx</a><a class="chip" href="#">Staten Island</a><a class="chip" href="#">Long Island</a><a class="chip" href="#">Westchester</a>
      </div>
    </div>
    <div class="hero-facts">
      <div class="fact"><b class="num">{certified.length}</b><span>Certified firms in NYC</span></div>
      <div class="fact"><b class="num">{firms.length}</b><span>Firms listed</span></div>
      <div class="fact"><b class="num">{practiceTiles.length}</b><span>{practiceTiles.length === 1 ? 'Practice area covered' : 'Practice areas covered'}</span></div>
      <div class="fact"><b class="num">{share(freeConsult)}</b><span>Offer free consultation</span></div>
      <div class="fact"><b class="num">{share(multilingual)}</b><span>Multilingual staff</span></div>
    </div>
  </div>
</section>

<!-- Practice areas in NYC -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <div><span class="eyebrow">Browse by legal need</span><h2 style="margin-top:12px">Law firms in New York by practice area</h2></div>
      
    </div>
    <div class="cat-grid">
      {practiceTiles.map(t => (
        <a class="cat" href={`/practice-areas/${t.slug}/`}><span class="ico"><Icon name={t.icon} /></span><b>{t.name}</b><span class="num">{t.count} certified {t.count === 1 ? 'firm' : 'firms'} · {t.listed} listed</span></a>
      ))}
    </div>
  </div>
</section>

<!-- Top firms in NYC -->
<section class="section section--tint">
  <div class="container layout">
    <div>
      <div class="results-head"><h2>Highest-ranked law firms in New York City</h2><span>Across all practice areas{lastUpdated ? ` · ${lastUpdated}` : ''}</span></div>
      <div class="firm-list">
        {firms.map((firm, i) => (
          <FirmCard firm={firm} rank={i + 1} rankLabel={i === 0 ? '#1 in NYC' : `#${i + 1}`} logoVariant={logoVariants[i % logoVariants.length]} />
        ))}
      </div>
      {firms.length === 0 && (
        <div class="callout"><b>Nothing published here yet.</b> The New York cohort is still in verification. Firms appear once their eligibility gates are checked.</div>
      )}
      
    </div>
    <aside class="sidebar">
      <div class="panel panel--ink">
        <h4>Get matched with a NYC firm</h4>
        <p>Answer four questions and we'll connect you with up to three certified firms in your borough. Free and confidential.</p>
        <a class="btn btn--white" href="#">Start matching</a>
      </div>
      <div class="panel">
        <h4>New York rankings</h4>
        <ul>
          <li><a href="/guides/best-personal-injury-law-firms-nyc/">Best personal injury firms in NYC</a></li>
          <li><a href="#">Best divorce lawyers in Manhattan</a></li>
          <li><a href="#">Best criminal defense firms in Brooklyn</a></li>
          <li><a href="#">Best immigration lawyers in Queens</a></li>
          <li><a href="#">Best real estate attorneys in NYC</a></li>
        </ul>
      </div>
    </aside>
  </div>
</section>

<!-- Local context -->
<section class="section section--paper">
  <div class="narrow prose">
    <span class="eyebrow">Know before you hire</span>
    <h2 style="margin-top:14px">Hiring a lawyer in New York City: what's different</h2>
    <p>New York's court system is unusually layered. Most civil cases over $50,000 are heard in the Supreme Court of the county (Manhattan is New York County; Brooklyn is Kings), while criminal matters move through Criminal Court before indictment and Supreme Court after. Federal cases fall in the Southern District (Manhattan, the Bronx, Westchester) or Eastern District (Brooklyn, Queens, Staten Island, Long Island). Firms that practice regularly in your specific courthouse know the judges, the clerks and the calendars — and that matters.</p>
    <h3>What lawyers cost in NYC</h3>
    <p>Hourly rates for experienced attorneys in Manhattan run from roughly $450 for a solo practitioner to $1,200 or more at large firms. Personal injury firms work on contingency (typically 33⅓%). Uncontested divorces are often flat-fee ($3,500–$7,500), and immigration matters are almost always flat-fee by petition type.</p>
    <h3>Deadlines that catch New Yorkers out</h3>
    <ul>
      <li><b>Personal injury:</b> 3 years from the accident — but only <b>90 days</b> to file a Notice of Claim against the City, MTA or NYCHA.</li>
      <li><b>Medical malpractice:</b> 2 years and 6 months from the malpractice (with a discovery rule for foreign objects and missed cancer diagnoses).</li>
      <li><b>Wrongful termination / discrimination:</b> 3 years under the NYC Human Rights Law; 300 days to file with the EEOC.</li>
    </ul>
    <div class="callout"><b>Verify before you hire.</b> Every attorney at a certified firm has been checked against the New York State Unified Court System's attorney registration database. You can run the same check yourself at iapps.courts.state.ny.us.</div>
  </div>
</section>

<!-- Neighborhoods -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <div><span class="eyebrow">By borough &amp; neighborhood</span><h2 style="margin-top:12px">Certified firms near you</h2></div>
    </div>
    <div class="city-grid">
      {boroughTiles.map(b => (
        <div class={`city ${b.cls}`}><Icon name="sky_sm" /><div class="t"><b>{b.name}</b><span class="num">{b.count} {b.count === 1 ? 'firm with an office here' : 'firms with an office here'}</span></div></div>
      ))}
    </div>
  </div>
</section>

<section class="section section--paper">
  <div class="narrow">
    <span class="eyebrow">Frequently asked</span>
    <h2 style="margin:14px 0 28px">Hiring a law firm in New York — FAQ</h2>
    <div class="faq">
      <details open><summary>How do I check if a New York lawyer is licensed?</summary><div>Search the New York State Unified Court System attorney registration database. It shows registration status, year admitted and any public discipline. Every attorney at a LFL Certified firm has already passed this check.</div></details>
      <details><summary>Do New York law firms offer free consultations?</summary><div>89% of certified firms in NYC do. Personal injury, criminal defense and immigration firms almost always offer a free initial call; some family-law and business firms charge a reduced flat fee for a first strategy session.</div></details>
      <details><summary>Should I hire a firm in my borough?</summary><div>Not necessarily — many Manhattan firms appear regularly in Brooklyn and Queens courts. What matters more is regular practice in the specific courthouse handling your case. Firm profiles list the counties where each firm most often appears.</div></details>
      <details><summary>Can I get legal help in a language other than English?</summary><div>41% of certified NYC firms have multilingual staff. Filter any list by language — Spanish, Mandarin, Cantonese, Russian, Bengali, Haitian Creole and Korean are the most common.</div></details>
    </div>
  </div>
</section>

</Base>
