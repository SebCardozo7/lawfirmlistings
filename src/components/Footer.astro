---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

// The footer listed six cities and "All 100 cities" on every page of the site; five of the six
// had no page and the hundred do not exist. It now lists the cities that actually have firms.
const published = await getCollection('firms', f =>
  f.data.status !== 'sample' && f.data.status !== 'not_eligible');
const cities = [...new Map(published.map(f =>
  [f.data.market.city_slug, `${f.data.market.city}, ${f.data.market.state}`])).entries()]
  .sort((a, b) => a[1].localeCompare(b[1]));

// Only practice areas that have both a page and a firm behind them. The footer used to list
// five more that went to href="#", on every page of the site.
const PRACTICE_PAGES = new Set(['personal-injury']);
const practices = [...new Map(published.flatMap(f => f.data.practices)
  .filter(pr => PRACTICE_PAGES.has(pr.slug))
  .map(pr => [pr.slug, pr.name])).entries()].sort((a, b) => a[1].localeCompare(b[1]));

// Destinations the directory intends to cover. They stay visible as a roadmap and render
// unlinked until the page exists, rather than as an href="#" a reader can click into nothing.
const PLANNED_PRACTICES = ['Family & Divorce', 'Criminal Defense', 'Immigration',
                           'Estate Planning', 'Business & Corporate'];
const PLANNED_RESOURCES = ['Best-of rankings', 'Legal guides', 'Cost of a lawyer',
                           'How to hire a law firm'];
// Privacy policy and Terms of use belong here for now, and are the two this site cannot
// launch without.
const PLANNED_COMPANY = ['About us', 'For law firms', 'Editorial standards', 'Contact',
                         'Privacy policy', 'Terms of use'];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/">
          <span class="brand-mark"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 2.6v5.2c0 4.6-3 8.8-7 10.2-4-1.4-7-5.6-7-10.2V5.6L12 3z" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.8 12.2l2.2 2.2 4.4-4.8" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <span>Law Firm Listings<small>Ranked · Verified · Independent</small></span>
        </a>
        <p>An independent directory of vetted law firms across the United States. We verify licensure, disciplinary history and client outcomes so you can research with confidence.</p>
      </div>
      <div>
        <h4>Practice areas</h4>
        <ul>
          {practices.map(([slug, name]) => (
            <li><a href={`/practice-areas/${slug}/`}>{name}</a></li>
          ))}
          {PLANNED_PRACTICES.map(name => <li><span class="soon">{name}</span></li>)}
        </ul>
      </div>
      <div>
        <h4>{cities.length === 1 ? 'City' : 'Cities'}</h4>
        <ul>
          {cities.map(([slug, label]) => (
            <li><a href={`/cities/${slug}/`}>{label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Resources</h4>
        <ul>
          <li><a href="/methodology/">Our methodology</a></li>
          {PLANNED_RESOURCES.map(name => <li><span class="soon">{name}</span></li>)}
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          {PLANNED_COMPANY.map(name => <li><span class="soon">{name}</span></li>)}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>LawFirmListings.com is not a law firm and does not provide legal advice. Rankings are editorial opinions based on our published methodology and do not constitute an endorsement or guarantee of results. Attorney advertising where applicable.</p>
      <span>© {new Date().getFullYear()} Law Firm Listings. All rights reserved.</span>
    </div>
  </div>
</footer>
