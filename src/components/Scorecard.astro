---
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { firm: CollectionEntry<'firms'>; cohortSize?: number; cohortLabel?: string }
const { firm, cohortSize, cohortLabel } = Astro.props;
const d = firm.data; const s = d.score;
if (!s) throw new Error(`No score for ${d.slug} — run scripts/score.py`);
const pillarNames: Record<string,string> = { A: 'Professional Standing', B: 'Published Outcomes', C: 'Client Experience', D: 'Digital Presence & Authority', E: 'Access & Responsiveness' };
const gateNames: Record<string,string> = { G1: 'Licensure', G2: 'Discipline', G3: 'Entity & office', G5: 'Website', G6: 'Footprint' };
const tagLabel = (src: string) => ({ registry: 'Registry', observed: 'Observed', ahrefs: `Ahrefs · ${d.digital.ahrefs?.measured_at ?? ''}`, places: 'Google', psi: 'PageSpeed', court: 'Court records', firm: 'Firm-submitted', illustrative: 'Illustrative', partial: 'Not fully read', pending: 'Pending' }[src] ?? src);
// 'partial' means the check ran and could not reach everything it needed, so the row is
// not a finding about the firm and score.py keeps it out of the scale. It was rendering
// as the bare word "partial" next to a zero, which reads like a verdict.
const isMeasured = (src: string) => ['registry','observed','ahrefs','places','psi','court'].includes(src);
const nextMonth = new Date(); nextMonth.setMonth(nextMonth.getMonth() + 1, 1);
const nextCheck = nextMonth.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const verified = new Date(s.computed_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
// An allowlist, not a denylist. This was `tier !== 'Listed' && tier !== 'Not eligible'`, so
// when the engine gained a third non-certified state the badge kept rendering: a firm whose own
// scorecard said "Under review · 2 eligibility gates still to be checked" was crowned "LFL
// Certified 2026" directly above it. Any tier this file has not been taught about is not
// certified.
// The same vocabulary score.py uses in NOT_A_FINDING, and for the same reason: a gate that did
// not pass is a failure only if we ran a check and it came back adverse. This card was labelling
// "Maryland does not publish an attorney register we can query" as "Not passed", which reads as
// a finding against a firm for something its state does not publish.
const NOT_A_FINDING = ['pending', 'partial', 'no queryable source', 'unavailable',
                       'screening only', 'incomplete', 'not yet'];
const notAFinding = (source: string) =>
  NOT_A_FINDING.some(w => (source ?? '').toLowerCase().includes(w));

// A gate its state publishes no source for is not a gate we skipped, and labelling it "Not
// checked" put the blame on us for a register the state does not let anyone read. The row says
// whose gap it is: "Not published by Maryland", next to evidence that names the register and why
// we leave it alone.
const NO_STATE_SOURCE = ['no queryable source', 'unavailable'];
// A firm that names no attorney anywhere leaves nothing to check, which is a fact about
// its own site rather than about the state or about us.
const noRoster = (source: string) =>
  (source ?? '').toLowerCase().includes('no roster published');
const noStateSource = (source: string) =>
  NO_STATE_SOURCE.some(w => (source ?? '').toLowerCase().includes(w));

const CERTIFIED_TIERS = ['Certified', 'Distinguished', 'Elite'];
const isCertified = CERTIFIED_TIERS.includes(s.tier);
const tierLabel = s.tier === 'Certified' ? 'LFL Certified' : isCertified ? `LFL Certified · ${s.tier}` : s.tier;
---
<div class="scorecard">
  <div class="aurora" aria-hidden="true"><i class="b1"></i><i class="b3"></i></div>
  <div class="sc-top">
    {/* The ring reads as a percentage now, because that is what the number is: a share of the
        sub-factors we have assessed, not a tally out of a hundred points most of which nobody
        has looked at. The coverage sits directly under it so the two are never separated. */}
    <div class="score-ring" style={`--pct:${s.total}%`}><b>{s.total}<small>out of 100</small></b></div>
    <div>
      <span class="tier-name">LFL Certification Score · Methodology {s.methodology}</span>
      {/* Two different reasons a point is not scored, and saying "evidence we have not
          collected" about both put a state's decision on our tab. Maryland publishes no attorney
          register we may query, so the points behind it are not ours to go and collect: they are
          not on the scale in that market at all, which is why the engine reports `assessable`
          separately from `assessed`. */}
      {s.assessed !== undefined && (
        <span class="sc-coverage">
          Scored across {s.assessed} of the {s.assessable ?? 100} points this firm's state lets
          anyone measure{s.assessable !== undefined && s.assessable < 100 ? (
            <>, out of 100 in the methodology: {100 - s.assessable} of them need a register that {d.market.state_name} does not publish for us to read</>
          ) : null}. Anything unscored counts neither for nor against the firm.
        </span>
      )}
      <h3>{tierLabel}</h3>
      <p>{s.verdict}</p>
      {!isCertified && s.tier === 'Verified' && <span class="badge badge--verified"><Icon name="check" /> LFL Verified {new Date(s.computed_at).getFullYear()}</span>}
      {isCertified && <span class="badge badge--certified"><Icon name="shield" /> LFL Certified {new Date(s.computed_at).getFullYear()} · re-verified {verified}</span>}
    </div>
    {s.next_tier && (
      <div class="sc-next">
        {/* A gap in points is only the real distance when the coverage requirement is already
            met. Where it is not, the points cannot lift the firm and saying so is the point. */}
        <b>{s.next_tier.coverage_met === false
          ? `${s.next_tier.name} needs more measured`
          : `${s.next_tier.gap} points to ${s.next_tier.name}`}</b>
        <div class="track"><i style={`width:${s.total}%`}></i></div>
        <span>{s.next_tier.needed} needed · A+B+C floor {s.next_tier.floor_met ? 'met' : 'not yet met'}{s.floor_abc_pct !== undefined && ` (${Math.round(s.floor_abc_pct * 100)}% of the A, B and C points assessed)`}</span>
        <div style="margin-top:10px;color:#fff">Most headroom: {s.next_tier.path.join(' · ')}</div>
      </div>
    )}
  </div>
  <div class="sc-gates">
    {/* Every gate used to render a check, including the ones that had not passed: a reader saw a
        tick beside "Licensure" on a firm whose licensure gate was open. The icon now follows the
        state, and an attested gate says so, because a gate the firm asserted and a gate we
        measured are not the same evidence and should not look identical. */}
    {Object.entries(d.gates).map(([code, g]) => (
      <div class={`sc-gate ${g.pass ? (g.attested ? 'is-attested' : 'is-pass') : notAFinding(g.source) ? 'is-pending' : 'is-fail'}`}>
        <Icon name={g.pass ? 'check' : 'clock'} />
        <div>{code} {gateNames[code]}
          {g.attested && <span class="sc-tag">Firm-attested</span>}
          {!g.pass && <span class="sc-tag">{noRoster(g.source)
              ? 'No attorneys published'
              /* A check that ran and cannot resolve is neither open work nor a finding, and
                 "Not checked" said the first of those about the second. The record answered;
                 it just could not answer about this firm, and the evidence line underneath
                 says which record and why. */
              : g.unresolvable
              ? 'No answer in the record'
              : noStateSource(g.source)
              /* The code, not the name: uppercased in a pill, "NOT PUBLISHED BY MARYLAND"
                 wrapped into a three-line blob beside a one-line gate. The evidence below
                 names the state in full and explains which register it means. */
              ? `Not published by ${d.market.state}`
              : notAFinding(g.source) ? 'Not checked' : 'Not passed'}</span>}
          <small>{g.evidence}</small>
        </div>
      </div>
    ))}
  </div>
  <div class="sc-pillars">
    {(['A','B','C','D','E'] as const).map((p, i) => { const pl = s.pillars[p]; return (
      <details class="sc-pillar" open={p === 'A' || p === 'D'}>
        <summary><span class={`l w${p}`}>{p}</span><b>{pillarNames[p]}</b><div class="bar"><i style={`width:${Math.round(pl.score / pl.max * 100)}%`}></i></div><span class="v">{pl.score}<small>/{pl.max}</small></span></summary>
        <div class="sc-sub">
          {pl.subs.map(sub => (
            <div class="sc-row"><span>{sub.code} {sub.label}<span class={`src-tag ${isMeasured(sub.source) ? 'ok' : ''}`}>{tagLabel(sub.source)}</span></span><span class="ev">{sub.evidence}</span><span class="pt">{sub.pts} / {sub.max}</span></div>
          ))}
        </div>
      </details>
    ); })}
  </div>
  <div class="sc-foot"><span>Next automated re-check: {nextCheck} · Cohort: {cohortLabel ?? d.cohort_id}{cohortSize ? ` (${cohortSize} firms measured)` : ''}</span><span><a href="/methodology/">How the score works →</a></span></div>
</div>
