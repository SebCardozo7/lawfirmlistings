interface Props { name: keyof typeof ICONS | string; class?: string }
const { name, class: cls } = Astro.props;
let svg = ICONS[name] ?? '';
if (cls) svg = svg.replace('<svg ', `<svg class="${cls}" `);
---
<Fragment set:html={svg} />
