---
import Icon from './Icon.astro';
interface Props { nav?: string }
const { nav = 'home' } = Astro.props;
---
<header class="site-header">
  <div class="container">
    <nav class="navpill" aria-label="Main">
      <a class="brand" href="/" aria-label="Law Firm Listings, home">
        {/* Two files rather than one: below 820px the pill has no room for a wordmark, and a
            lockup cannot shed half of itself. Both are eager, because the brand is the first
            thing painted and a lazy logo flashes empty on every navigation. */}
        <img class="brand-lockup" src="/brand/logo-dark.png" width="640" height="116"
             alt="Law Firm Listings" />
        <img class="brand-mark-img" src="/brand/mark-dark.png" width="256" height="256"
             alt="" aria-hidden="true" />
      </a>
      <ul class="nav-links">
        <li><a href="/practice-areas/" aria-current={nav==='practice'?'page':undefined}><Icon name="scale" /><span>Practice Areas</span></a></li>
        <li><a href="/cities/" aria-current={nav==='cities'?'page':undefined}><Icon name="pin" /><span>Cities</span></a></li>
        <li><a href="/methodology/" aria-current={nav==='method'?'page':undefined}><Icon name="shield" /><span>Methodology</span></a></li>
        <li><a href="/guides/" aria-current={nav==='guides'?'page':undefined}><Icon name="doc" /><span>Guides</span></a></li>
      </ul>
      <div class="nav-actions">
        <a class="btn btn--ghost btn--sm" href="/list-your-firm/"
           aria-current={nav==='list'?'page':undefined}>List your firm</a>
        <a class="btn btn--primary btn--sm" href="/cities/new-york-ny/personal-injury/">Find a firm</a>
        <button class="nav-toggle" aria-label="Open menu"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h14M3 10h14M3 15h14"/></svg></button>
      </div>
    </nav>
  </div>
</header>
