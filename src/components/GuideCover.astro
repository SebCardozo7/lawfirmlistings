---
/**
 * The framed cover panel at the top of a guide: night ground, aurora, and the article's own
 * vector scene. The scene itself lives in CoverArt.astro, because the cards on the guides index
 * draw the same art at a different size and two copies would drift apart.
 */
import CoverArt from './CoverArt.astro';

interface Props {
  /** Which scene to draw. An unknown name falls back to the plain aurora panel. */
  name: 'results' | 'reviews' | 'speed' | 'fees' | 'ranking' | 'ladder' | 'roster' | 'shield';
}
const { name } = Astro.props;
---
<div class="article-cover">
  <div class="container">
    <div class="cover" aria-hidden="true">
      <div class="aurora"><i class="b1"></i><i class="b2"></i><i class="b3"></i><span class="glow"></span></div>
      <CoverArt name={name} />
    </div>
  </div>
</div>
