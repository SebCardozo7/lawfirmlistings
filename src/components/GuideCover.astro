---
/**
 * The cover image for a guide, drawn rather than photographed.
 *
 * Every guide used to render the same night panel with a faded icon and a chip reading "Custom
 * cover image slot", which is a note to ourselves that we were publishing to readers. These are
 * the finished article: one vector scene per piece, in the same night ground and aurora the rest
 * of the site uses, built from the shapes the piece is actually about. The results study gets
 * counted bars and an unclosed seal, the reviews study gets identical stars over wildly different
 * bars, and so on. Nothing here is stock art and nothing is generated at request time: it is a
 * few dozen shapes in the brand palette, inline, so it costs no network request and scales to any
 * screen without a second file.
 *
 * The scenes are decorative. Everything they say, the headline and the lede say in words
 * directly underneath, so the whole panel is aria-hidden rather than carrying a description a
 * screen reader would have to sit through twice.
 */
interface Props {
  /** Which scene to draw. An unknown name falls back to the plain aurora panel. */
  name: 'results' | 'reviews' | 'speed' | 'fees' | 'ranking';
}
const { name } = Astro.props;

// The three aurora accents, used as strokes here rather than as blurred blobs.
const VIOLET = '#A78BFA';
const BLUE = '#60A5FA';
const MINT = '#5EEAD4';

// Published results: nine figures on a page, three of them attached to something checkable, and
// a seal that never closes. The dashed ring is the verification we have not done.
const results = { bars: [120, 186, 96, 232, 150, 268, 110, 198, 140], checked: [1, 3, 5] };
---
<div class="article-cover">
  <div class="container">
    <div class="cover" aria-hidden="true">
      <div class="aurora"><i class="b1"></i><i class="b2"></i><i class="b3"></i><span class="glow"></span></div>

      {name === 'results' && (
        <svg class="cover-art" viewBox="0 0 1200 440" preserveAspectRatio="xMidYMid slice">
          <g stroke="rgba(255,255,255,.10)" stroke-width="1">
            {[0, 1, 2, 3].map(i => <line x1="90" y1={130 + i * 60} x2="1110" y2={130 + i * 60} />)}
          </g>
          <g>
            {results.bars.map((h, i) => (
              <rect x={150 + i * 74} y={370 - h} width="30" height={h} rx="6"
                fill={results.checked.includes(i) ? VIOLET : 'rgba(255,255,255,.22)'}
                opacity={results.checked.includes(i) ? '.95' : '1'} />
            ))}
          </g>
          <line x1="120" y1="370" x2="1080" y2="370" stroke="rgba(255,255,255,.35)" stroke-width="2" />
          <g transform="translate(940,150)">
            <circle r="74" fill="none" stroke={MINT} stroke-width="2.5" stroke-dasharray="16 13" opacity=".85" />
            <circle r="50" fill="none" stroke="rgba(255,255,255,.25)" stroke-width="1.5" />
            <path d="M-22 0l16 16 30-32" fill="none" stroke={MINT} stroke-width="3"
              stroke-linecap="round" stroke-linejoin="round" opacity=".35" />
          </g>
        </svg>
      )}

      {name === 'reviews' && (
        <svg class="cover-art" viewBox="0 0 1200 440" preserveAspectRatio="xMidYMid slice">
          {/* Five identical stars on one line: the ratings that barely differ. */}
          <g transform="translate(150,140)">
            {[0, 1, 2, 3, 4].map(i => (
              <path transform={`translate(${i * 92},0) scale(1.9)`}
                d="M0 -16l4.9 9.9 10.9 1.6-7.9 7.7 1.9 10.9L0 18.9l-9.8 5.2 1.9-10.9-7.9-7.7 10.9-1.6z"
                fill={i < 4 ? 'rgba(255,255,255,.92)' : 'rgba(255,255,255,.28)'} />
            ))}
          </g>
          {/* The counts underneath, which differ by orders of magnitude. */}
          <g>
            {[820, 520, 330, 210, 120, 70].map((w, i) => (
              <rect x="150" y={232 + i * 32} width={w} height="14" rx="7"
                fill={i === 0 ? VIOLET : 'rgba(255,255,255,.20)'} />
            ))}
          </g>
          <circle cx="1010" cy="150" r="86" fill="none" stroke={BLUE} stroke-width="2" opacity=".5" />
          <circle cx="1010" cy="150" r="52" fill="none" stroke={MINT} stroke-width="2" opacity=".45" />
        </svg>
      )}

      {name === 'speed' && (
        <svg class="cover-art" viewBox="0 0 1200 440" preserveAspectRatio="xMidYMid slice">
          {/* A gauge with the needle low, over a skyline: the piece in one shape. */}
          <g transform="translate(600,330)">
            <path d="M-260 0a260 260 0 0 1 520 0" fill="none" stroke="rgba(255,255,255,.16)" stroke-width="26" stroke-linecap="round" />
            <path d="M-260 0a260 260 0 0 1 96-201" fill="none" stroke={MINT} stroke-width="26" stroke-linecap="round" opacity=".9" />
            <path d="M-164 -201a260 260 0 0 1 150-56" fill="none" stroke={VIOLET} stroke-width="26" stroke-linecap="round" opacity=".55" />
            <line x1="0" y1="0" x2="-198" y2="-92" stroke="#fff" stroke-width="5" stroke-linecap="round" />
            <circle r="13" fill="#fff" />
          </g>
          <g fill="rgba(255,255,255,.14)">
            <rect x="120" y="330" width="54" height="110" /><rect x="186" y="286" width="38" height="154" />
            <rect x="236" y="312" width="62" height="128" /><rect x="906" y="300" width="46" height="140" />
            <rect x="962" y="264" width="34" height="176" /><rect x="1006" y="322" width="66" height="118" />
          </g>
        </svg>
      )}

      {name === 'fees' && (
        <svg class="cover-art" viewBox="0 0 1200 440" preserveAspectRatio="xMidYMid slice">
          {/* A fee page with every line printed except the one that matters. */}
          <g transform="translate(300,70)">
            <rect width="420" height="330" rx="22" fill="rgba(255,255,255,.07)" stroke="rgba(255,255,255,.22)" stroke-width="1.5" />
            {[0, 1, 2].map(i => <rect x="46" y={62 + i * 34} width={i === 1 ? 250 : 320} height="12" rx="6" fill="rgba(255,255,255,.26)" />)}
            <rect x="46" y="176" width="180" height="30" rx="8" fill={VIOLET} opacity=".9" />
            <rect x="240" y="176" width="80" height="30" rx="8" fill="rgba(255,255,255,.12)" stroke={MINT} stroke-width="1.5" stroke-dasharray="7 6" />
            {[0, 1].map(i => <rect x="46" y={232 + i * 34} width={i === 1 ? 210 : 300} height="12" rx="6" fill="rgba(255,255,255,.26)" />)}
          </g>
          <g transform="translate(880,220)" opacity=".9">
            <circle r="96" fill="none" stroke="rgba(255,255,255,.2)" stroke-width="1.5" />
            <circle cx="-30" cy="-30" r="20" fill="none" stroke={MINT} stroke-width="5" />
            <circle cx="30" cy="30" r="20" fill="none" stroke={MINT} stroke-width="5" />
            <line x1="-44" y1="46" x2="44" y2="-46" stroke="#fff" stroke-width="5" stroke-linecap="round" />
          </g>
        </svg>
      )}

      {name === 'ranking' && (
        <svg class="cover-art" viewBox="0 0 1200 440" preserveAspectRatio="xMidYMid slice">
          <g>
            <rect x="420" y="210" width="120" height="190" rx="10" fill="rgba(255,255,255,.20)" />
            <rect x="556" y="150" width="120" height="250" rx="10" fill={VIOLET} opacity=".9" />
            <rect x="692" y="248" width="120" height="152" rx="10" fill="rgba(255,255,255,.20)" />
          </g>
          <circle cx="616" cy="96" r="38" fill="none" stroke={MINT} stroke-width="3" />
          <path d="M600 96l12 12 22-24" fill="none" stroke={MINT} stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
          <line x1="180" y1="400" x2="1020" y2="400" stroke="rgba(255,255,255,.35)" stroke-width="2" />
          <g fill="rgba(255,255,255,.10)">
            <rect x="180" y="330" width="40" height="70" rx="8" /><rect x="232" y="358" width="40" height="42" rx="8" />
            <rect x="928" y="344" width="40" height="56" rx="8" /><rect x="980" y="366" width="40" height="34" rx="8" />
          </g>
        </svg>
      )}
    </div>
  </div>
</div>
